#!/usr/bin/env bash
# xgm-egpu — activate/deactivate the XG Mobile eGPU on an ASUS ROG Flow X13 (GV301QH).
#
# Why this exists: writing egpu_enable makes ACPI eject the *internal* dGPU slot.
# NVIDIA's nv_pci_remove() then spins in a poll-and-wait loop until the internal
# GPU's usage count hits zero. If anything still holds /dev/nvidia*, the ACPI
# hotplug mutex is held forever and the writing process parks in uninterruptible
# D state — unkillable, terminal wedged, reboot required.
#
# So: release the internal GPU completely BEFORE the write, and never let the
# write block the foreground shell.
#
# Refs: drivers/platform/x86/asus-armoury.c :: egpu_enable_current_value_store()
#       include/linux/platform_data/x86/asus-wmi.h (DEVID 0x00090019)

set -uo pipefail

FW=/sys/class/firmware-attributes/asus-armoury/attributes
ATTR_ENABLE=$FW/egpu_enable/current_value
ATTR_CONNECTED=$FW/egpu_connected/current_value
ATTR_DGPU=$FW/dgpu_disable/current_value

# Machine topology. Empty on purpose: detect_topology() derives these from sysfs
# at startup, so the script is not tied to the machine it was written on.
#
#   INTERNAL_DGPU  the discrete GPU sharing PCIe lanes with the XGM port, which is
#                  therefore ejected on activation. EMPTY on hosts that have none
#                  (ROG Ally) — a supported configuration, not an error. There is
#                  simply nothing to eject, which removes the hardest part of the
#                  whole problem.
#   ROOT_PORT      the bridge hosting that slot, and the XGM's lanes.
#   INTERNAL_DEVID the internal dGPU's device ID. The XGM port shares its lanes
#                  (that is *why* activation ejects it), so the eGPU may well claim
#                  the same address. Identify it by device ID, never by address.
#
# Override any of them in /etc/xgm-egpu.conf, via the environment, or with
# --root-port / --internal-dgpu. If detection gets it wrong, please open an issue:
# it is meant to work everywhere and a machine it fails on is a bug worth fixing.
INTERNAL_DGPU=${INTERNAL_DGPU:-}
ROOT_PORT=${ROOT_PORT:-}
INTERNAL_DEVID=${INTERNAL_DEVID:-}

CONFIG_FILE=${XGM_CONFIG:-/etc/xgm-egpu.conf}

# Cache for facts only learnable while egpu_enable=0. Once the eGPU is active it
# occupies the internal dGPU's address, so "which display device is the internal
# one" stops being answerable by looking at the bus.
STATE_DIR=${XGM_STATE_DIR:-/var/lib/xgm-egpu}
STATE_FILE=$STATE_DIR/topology.conf

NV_MODULES=(nvidia_drm nvidia_modeset nvidia_uvm nvidia)
NV_SERVICES=(nvidia-powerd nvidia-persistenced)

# Paths the new checks read. Overridable so the test-suite can point them at
# fixture files and run without root or hardware.
NV_PARAMS=${XGM_NV_PARAMS:-/proc/driver/nvidia/params}
NV_GPUS_DIR=${XGM_NV_GPUS_DIR:-/proc/driver/nvidia/gpus}
MKINITCPIO_CONF=${XGM_MKINITCPIO_CONF:-/etc/mkinitcpio.conf}
MKINITCPIO_D=${XGM_MKINITCPIO_D:-/etc/mkinitcpio.conf.d}
DISTRO_MODPROBE=${XGM_DISTRO_MODPROBE:-/usr/lib/modprobe.d/nvidia.conf}
ETC_MODPROBE_D=${XGM_ETC_MODPROBE_D:-/etc/modprobe.d}
AUTOPROBE=${XGM_AUTOPROBE:-/sys/bus/pci/drivers_autoprobe}
SYS_MODULE=${XGM_SYS_MODULE:-/sys/module}
SYSFS_PCI=${XGM_SYSFS_PCI:-/sys/bus/pci/devices}
DRM_POLL=${XGM_DRM_POLL:-/sys/module/drm_kms_helper/parameters/poll}
PSTORE=${XGM_PSTORE:-/sys/fs/pstore}
EFI_PSTORE_DISABLE=${XGM_EFI_PSTORE_DISABLE:-/sys/module/efi_pstore/parameters/pstore_disable}
NV_VERSION=${XGM_NV_VERSION:-/proc/driver/nvidia/version}
GSP_CONF=${XGM_GSP_CONF:-$ETC_MODPROBE_D/nvidia-xgm-nogsp.conf}
DRM_CONF=${XGM_DRM_CONF:-$ETC_MODPROBE_D/nvidia-xgm-drm.conf}
PCIE_CONF=${XGM_PCIE_CONF:-$ETC_MODPROBE_D/nvidia-xgm-pcie.conf}
NVKMS_NODE=${XGM_NVKMS_NODE:-/dev/nvidia-modeset}
LOG_DIR=${XGM_LOG_DIR:-/var/log/xgm-egpu}        # persistent per-run logs (root fs, survives reboots)
RUN_LOG=                                          # set by run_log_start for state-changing commands
NETCONSOLE_TARGET=${XGM_NETCONSOLE_TARGET:-192.168.1.7}   # the Pi
BUGREPORT_DIR=${XGM_BUGREPORT_DIR:-/var/tmp}

# The write legitimately takes a long time: it drives a full ACPI eject and PCI
# rescan cycle synchronously. Observed 2026-07-31 — an 'off' that "timed out" at
# 25s had in fact completed successfully a short while later. Slow is not stuck,
# and calling it stuck sent me chasing a hardware fault that wasn't there.
PATIENCE=20           # seconds before saying "still working" — informational only
TIMEOUT=180           # seconds before treating the write as genuinely wedged

# The EC block the platform's own AML consults before it will switch anything.
# From osy's annotated ACPI (Docs/ACPI_Annotated.asl), WMNB/DEVS 0x00090019 reads
# 4 bytes at EC offset 0x1C and REFUSES to proceed if AC is lost or the connector
# lock is not engaged. Reading it tells us what the firmware sees, with no risk.
EC_IO=/sys/kernel/debug/ec/ec0/io
EC_XGM_OFF=28         # 0x1C
WEDGE_SAMPLE=4        # seconds to watch a D-state task before believing it is stuck
SETTLE=20             # seconds to wait for the eGPU to enumerate after activation
FORCE_KILL=0
DRY_RUN=0
# How much to tear down before the write. Evidence from 2026-07-31, four attempts:
# the ONLY one that did not kill the machine was the one where nvidia was still
# loaded and bound, and Linux performed a genuine eject. Every additional bit of
# pre-emptive cleanup made it fail harder and faster.
#
# The AML explains why. Step 3's SUMA(0x01) sends eject notify 0x03 and then calls
# WAT1(), a polling loop that WAITS FOR THE OS TO ACTUALLY EJECT. Strip the device
# and driver out beforehand and acpiphp has nothing to do, no state transition
# happens, and the firmware polls for something that will never arrive — then
# carries on to FGON() regardless.
#
#   minimal — stop nvidia-powerd/persistenced only. Driver stays bound, so the
#             eject is real and the firmware sees what it polls for. DEFAULT.
#   unload  — also unbind the driver and rmmod the stack.
#   remove  — also remove the device from the PCI tree. Most aggressive; worst
#             observed results.
RELEASE_LEVEL=minimal
IGNORE_RTD3=0         # --ignore-rtd3: activate even with RTD3 armed (to reproduce the failure)
SURVIVAL_SECS=15      # after the bind, watch the link this long. It used to die at 10s.
NO_DRM_POLL=0         # --no-drm-poll: set drm_kms_helper.poll=0 before loading nvidia_drm
NO_FBDEV=0            # --no-fbdev: REQUIRE the loaded nvidia_drm to have fbdev=0 (`drm nofbdev`).
                      # The 2026-09-09 "ruled out" run was a no-op — the module was resident and
                      # modprobe ignored the parameter; see the DRM-layer section. Untested.
NO_KMS=0              # --no-kms: REQUIRE the loaded nvidia_drm to have modeset=0 (`drm nokms`):
                      # render node only, no display-engine bring-up. PRIME offload still works.
CAP_POWER=0           # --cap-power: after the core binds, lock the GPU to minimum clocks and
                      # the lowest power limit BEFORE the display engine comes up. Tests the
                      # power hypothesis: a display-init current step trips the board's OCP
                      # hiccup (osy Diary: GPU on two parallel supplies, FETs cut on overcurrent).
MODESET_SAFE=0        # --modeset-safe: nvidia_modeset disable_hdmi_frl=1 disable_vrr_memclk_switch=1
                      # conceal_vrr_caps=1. The RPCs in flight at every death are HDMI-audio /
                      # VRR display setup on the 3060's physical outputs (the 1650 has none).
                      # REQUIRES `drm safe` applied first: resident modules ignore modprobe params.
MASK_PCIEHP=0         # --mask-pciehp: clear the root port's hotplug interrupt enables so a
                      # momentary Link Down is not turned into a surprise-removal teardown.
NO_AUDIO=1            # keep snd_hda_intel OFF the eGPU's HDMI-audio function (01:00.1). Every
                      # death on record has the HDA codec active at the instant of Link Down and
                      # the in-flight GSP RPC is DFP_SET_ELD_AUDIO_CAPS; the survivors had no
                      # audio driver bound and the internal 1650 has no audio function. --audio
                      # binds it as before (deliberately reproducing the death).
SEAL_NVKMS=1          # with --no-kms: bind-mount /dev/null over /dev/nvidia-modeset before the
                      # write, so no userspace client can allocate the eGPU's display engine.
                      # --no-seal skips it (deliberately reproducing the client-triggered death).
AUTO_CAPTURE=1        # arm the hang capture (pstore + panic-on-hang + netconsole) inside
                      # 'on' and 'bind' before the risky step; --no-capture skips it
RELOAD_NVIDIA=1       # modprobe the NVIDIA stack back after a successful switch;
                      # --no-reload leaves the eGPU enumerated but unbound

# Default OFF. Setting ASPM to "performance" keeps the link at its top speed
# instead of idling down to Gen1 — which sounded right and made things strictly
# worse on 2026-07-31: held at Gen3 the link died in ~18s at idle, whereas at Gen1
# it survived 15 minutes. Left available because it is the correct lever if the
# connectors are ever fixed.
ASPM_PERF=0

# Target PCIe generation to pin on the root port before switching. Empty leaves
# the firmware's choice alone. `--link-gen 1` is the mitigation for this machine:
# the link is stable at a steady Gen1 and cannot complete training at Gen2 or Gen3.
LINK_GEN=

# ---------------------------------------------------------------- output helpers

if [[ -t 1 ]]; then
    C_R=$'\e[31m'; C_G=$'\e[32m'; C_Y=$'\e[33m'; C_B=$'\e[34m'; C_0=$'\e[0m'
else
    C_R=; C_G=; C_Y=; C_B=; C_0=
fi
# Mirror everything into the journal. This machine has persistent journald, so if
# an attempt takes the kernel down with it, 'journalctl -b -1 -t xgm-egpu' still
# says how far we got — terminal scrollback does not survive a forced power-off.
_log() { [[ ${XGM_LIBRARY_MODE:-0} -eq 1 ]] && return 0; command -v logger >/dev/null 2>&1 && logger -t xgm-egpu -p "user.$1" -- "$2"; }

# ---------------------------------------------------------------- persistent run logs
#
# Terminal scrollback dies with a power-cycle and /tmp is tmpfs. Every
# state-changing command mirrors its complete output (colour codes stripped)
# to $LOG_DIR/<timestamp>-<command>.log, and the survival watch drops the
# kernel log beside it. 'xgm-egpu logs' lists them.
run_log_start() {
    local cmd=$1 argv=$2
    [[ $EUID -eq 0 ]] || return 0
    mkdir -p "$LOG_DIR" 2>/dev/null || return 0
    RUN_LOG="$LOG_DIR/$(date +%Y%m%d-%H%M%S)-$cmd.log"
    {
        printf '# xgm-egpu run log  %s\n' "$(date -Is)"
        printf '# command: xgm-egpu %s\n' "$argv"
        printf '# kernel: %s   driver: %s\n' "$(uname -r)" "$(grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' "$NV_VERSION" 2>/dev/null | head -1)"
        printf '# drm layer: %s   egpu_enable: %s   door: %s\n' "$(drm_layer_mode 2>/dev/null)" "$(read_attr "$ATTR_ENABLE" 2>/dev/null)" "$(nvkms_door_sealed && echo sealed || echo open)"
    } > "$RUN_LOG" 2>/dev/null || { RUN_LOG=; return 0; }
    # shellcheck disable=SC2312
    exec > >(tee >(sed -u $'s/\e\[[0-9;]*m//g' >> "$RUN_LOG")) 2>&1
    info "run log: $RUN_LOG"
}
# Snapshot the kernel log next to the run log (death: 600 lines, survival: 150).
save_kernel_log() {
    local lines=${1:-600} f
    [[ -n $RUN_LOG ]] || return 0
    f=${RUN_LOG%.log}-kernel.log
    { journalctl -k -b --no-pager 2>/dev/null || dmesg 2>/dev/null; } | tail -n "$lines" > "$f" 2>/dev/null && sync
    [[ -s $f ]] && info "kernel log saved: $f"
    [[ -r /var/tmp/xgm-last-run.txt ]] && cp -f /var/tmp/xgm-last-run.txt "${RUN_LOG%.log}-watch.txt" 2>/dev/null
    return 0
}
cmd_logs() {
    local sub=${1:-list} f n
    case $sub in
      dir)  printf '%s\n' "$LOG_DIR" ;;
      show)
        # timestamps lead the names, so lexical order is chronological
        local latest=''
        for f in "$LOG_DIR"/*.log; do [[ -e $f && $f != *-kernel.log ]] && latest=$f; done
        f=$latest
        [[ -n $f ]] || die "no run logs in $LOG_DIR yet"
        cat "$f"
        [[ -s ${f%.log}-kernel.log ]] && printf '\n# kernel log: %s (last 40 lines)\n' "${f%.log}-kernel.log" && tail -40 "${f%.log}-kernel.log"
        ;;
      list|[0-9]*)
        n=${sub//[!0-9]/}; n=${n:-10}
        [[ -d $LOG_DIR ]] || die "no run logs in $LOG_DIR yet (created by the first on/off/bind/reload-driver)"
        printf '%-28s %-10s %s\n' "log" "result" "command"
        local files=() i
        for f in "$LOG_DIR"/*.log; do [[ -e $f && $f != *-kernel.log ]] && files+=("$f"); done
        for (( i=${#files[@]}-1; i>=0 && n>0; i--, n-- )); do
            f=${files[i]}
            local res=refused
            grep -q 'LINK SURVIVED' "$f" && res=SURVIVED
            grep -qE 'link DIED|LINK DIED' "$f" && res=DIED
            printf '%-28s %-10s %s\n' "$(basename "$f")" "$res" "$(grep -m1 '^# command:' "$f" | cut -d: -f2-)"
        done
        printf '\n%s\n' "show the latest:  $0 logs show     crash dumps: ls -t $BUGREPORT_DIR/xgm-bugreport-*"
        ;;
      *) die "usage: $0 logs [list|N|show|dir]" ;;
    esac
}

info() { printf '%s==>%s %s\n' "$C_B" "$C_0" "$*";     _log info  "$*"; }
ok()   { printf '%s ok %s %s\n' "$C_G" "$C_0" "$*";    _log notice "$*"; }
warn() { printf '%s  ! %s %s\n' "$C_Y" "$C_0" "$*" >&2; _log warning "$*"; }
die()  { printf '%sfail%s %s\n' "$C_R" "$C_0" "$*" >&2; _log err "$*"; exit 1; }

# ---------------------------------------------------------------- topology detection
#
# Everything here reads sysfs only: no root, no lspci parsing, no setpci, nothing
# that can perturb the bus. Safe to run in any state.

# Parent BDF of a PCI device, or empty if it hangs directly off the host bridge.
pci_parent() {
    local p
    p=$(basename "$(dirname "$(readlink -f "/sys/bus/pci/devices/$1" 2>/dev/null)")" 2>/dev/null)
    [[ $p == 0000:* ]] && printf '%s' "$p"
}

# Every PCI display-class device (0x03xxxx: VGA, 3D controller, display).
display_devices() {
    local d c
    for d in /sys/bus/pci/devices/*/; do
        c=$(cat "$d/class" 2>/dev/null) || continue
        [[ $c == 0x03* ]] && basename "$d"
    done
}

# The pcieport bridge whose secondary bus is $1 (decimal).
port_for_bus() {
    local want=$1 d drv
    for d in /sys/bus/pci/devices/*/; do
        drv=$(basename "$(readlink -f "$d/driver" 2>/dev/null)" 2>/dev/null)
        [[ $drv == pcieport ]] || continue
        [[ $(cat "$d/secondary_bus_number" 2>/dev/null) == "$want" ]] || continue
        basename "$d"; return 0
    done
    return 1
}

# Hotplug-capable slots, as "PORT_BDF SLOT_NAME OCCUPIED".
#
# pciehp registers these in /sys/bus/pci/slots. The slot address is
# domain:bus:dev of the *downstream* side, so the port is the bridge whose
# secondary bus number matches. This is how we find the XGM port on a host with
# no internal dGPU: there is no display device to walk up from, but the empty
# hotplug slot is still there.
hotplug_slots() {
    local s addr bus port occupied
    for s in /sys/bus/pci/slots/*/; do
        addr=$(cat "$s/address" 2>/dev/null) || continue
        bus=${addr#*:}; bus=${bus%%:*}
        port=$(port_for_bus "$((16#$bus))") || continue
        occupied=0
        compgen -G "/sys/bus/pci/devices/0000:$bus:*" >/dev/null && occupied=1
        printf '%s %s %s\n' "$port" "$(basename "$s")" "$occupied"
    done
}

# The internal discrete GPU: a display device that is not the firmware's primary
# adapter. boot_vga=1 marks that primary, which on every ASUS laptop in scope is
# the APU's integrated graphics.
#
# ONLY valid while egpu_enable=0. Once the eGPU is up it sits at the address the
# internal dGPU vacated and is also a non-boot_vga display device, so this would
# happily return the eGPU. Callers must respect that, which is what the state
# cache below is for.
detect_internal_dgpu() {
    local bdf
    for bdf in $(display_devices); do
        [[ $(cat "/sys/bus/pci/devices/$bdf/boot_vga" 2>/dev/null || echo 0) == 1 ]] && continue
        printf '%s' "$bdf"; return 0
    done
    return 1
}

load_state()  { [[ -r $STATE_FILE ]] && . "$STATE_FILE"; return 0; }

save_state() {
    [[ $EUID -eq 0 ]] || return 0          # best effort; unprivileged runs just skip it
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    cat > "$STATE_FILE" 2>/dev/null <<EOF
# Written by xgm-egpu. Detected while egpu_enable=0, when the internal dGPU was
# still visible. Delete this file to force re-detection.
INTERNAL_DGPU=$INTERNAL_DGPU
INTERNAL_DEVID=$INTERNAL_DEVID
ROOT_PORT=$ROOT_PORT
EOF
    return 0
}

# Work out this machine's topology. Anything already set — by /etc/xgm-egpu.conf,
# the environment, or a command-line flag — is left alone.
_TOPOLOGY_DONE=0
detect_topology() {
    # Idempotent: the dispatcher runs this before every command, and cmd_detect
    # calls it too. Without the guard, anything it warns about gets printed twice.
    [[ $_TOPOLOGY_DONE -eq 1 ]] && return 0
    _TOPOLOGY_DONE=1

    [[ -r $CONFIG_FILE ]] && . "$CONFIG_FILE"

    local egpu_state; egpu_state=$(cat "$ATTR_ENABLE" 2>/dev/null || echo 0)

    if [[ $egpu_state == 0 ]]; then
        # Internal dGPU, if any, is visible right now. This is the only moment we
        # can tell it apart from an eGPU at the same address.
        if [[ -z $INTERNAL_DGPU ]]; then
            INTERNAL_DGPU=$(detect_internal_dgpu || true)
        fi
        if [[ -n $INTERNAL_DGPU && -z $INTERNAL_DEVID ]]; then
            INTERNAL_DEVID=$(cat "/sys/bus/pci/devices/$INTERNAL_DGPU/device" 2>/dev/null || true)
        fi
    else
        # eGPU active: the internal dGPU is gone. Recover its identity from cache
        # so egpu_bdf() can still exclude it, rather than guessing.
        load_state
    fi

    if [[ -z $ROOT_PORT ]]; then
        if [[ -n $INTERNAL_DGPU ]]; then
            # The XGM shares the internal dGPU's lanes, so its port is that dGPU's
            # parent bridge.
            ROOT_PORT=$(pci_parent "$INTERNAL_DGPU")
        else
            # No internal dGPU (ROG Ally). Fall back to the hotplug slots: if
            # exactly one is unoccupied, that is the XGM port. More than one and we
            # refuse to guess.
            local empty; empty=$(hotplug_slots | awk '$3 == 0 {print $1}')
            if [[ $(printf '%s\n' "$empty" | grep -c .) -eq 1 ]]; then
                ROOT_PORT=$empty
            elif [[ -n $empty ]]; then
                warn "several empty hotplug slots; cannot tell which is the XGM port:"
                printf '    %s\n' $empty >&2
                warn "set ROOT_PORT in $CONFIG_FILE or pass --root-port. See docs/PORTING.md"
            fi
        fi
    fi

    [[ $egpu_state == 0 && -n $ROOT_PORT ]] && save_state
    return 0
}

cmd_detect() {
    check_interface
    detect_topology

    printf '%-16s %s\n' "egpu_enable" "$(read_attr "$ATTR_ENABLE")"
    echo
    echo "Detected topology:"
    printf '  %-16s %s\n' "ROOT_PORT" "${ROOT_PORT:-<none — set it manually>}"
    if [[ -n $INTERNAL_DGPU ]]; then
        printf '  %-16s %s (devid %s)\n' "INTERNAL_DGPU" "$INTERNAL_DGPU" "${INTERNAL_DEVID:-?}"
    else
        printf '  %-16s %s\n' "INTERNAL_DGPU" "none — this host has no internal dGPU"
        echo "                   Nothing to eject: the hardest part of this problem does"
        echo "                   not apply to you. See docs/PORTING.md."
    fi
    echo
    echo "Display devices:"
    local bdf
    for bdf in $(display_devices); do
        printf '  %s  %s:%s  boot_vga=%s  parent=%s\n' "$bdf" \
            "$(cat "/sys/bus/pci/devices/$bdf/vendor" 2>/dev/null)" \
            "$(cat "/sys/bus/pci/devices/$bdf/device" 2>/dev/null)" \
            "$(cat "/sys/bus/pci/devices/$bdf/boot_vga" 2>/dev/null || echo 0)" \
            "$(pci_parent "$bdf")"
    done
    echo
    echo "Hotplug slots (port, slot, occupied):"
    hotplug_slots | sed 's/^/  /' || echo "  none"
    echo
    [[ -r $CONFIG_FILE ]] && echo "Config:  $CONFIG_FILE (in use)" || echo "Config:  $CONFIG_FILE (absent)"
    [[ -r $STATE_FILE  ]] && echo "Cache:   $STATE_FILE" || echo "Cache:   $STATE_FILE (not yet written)"
    echo
    echo "If any of this is wrong, please open an issue with this output —"
    echo "detection failing on a machine is a bug, not something to work around."
    return 0
}

# ---------------------------------------------------------------- nvidia RTD3
#
# THE root cause of the eGPU dying ~10s after the driver binds (found 2026-09-09):
#
# NVIDIA's "dynamic power management" (RTD3). On any GA102-or-newer GPU in a
# machine whose DMI chassis says notebook, the driver auto-selects FINE mode
# (src/nvidia/arch/nvalloc/unix/src/dynamic-power.c, rmReadAndParseDynamicPowerRegkey).
# In FINE mode an idle timer runs: 5s precondition check, IDLE_INSTANT ->
# IDLE_SUSTAINED, another 5s check, revoke mappings, 200ms, indicate idle.
# 5 + 5 + 0.2 = the exact 10 seconds observed, four times out of four.
#
# On a real Optimus laptop the platform expects the GPU to drop its link for
# GC6. On the XG Mobile port, pciehp is live, sees Link Down, and treats it as
# surprise removal: Xid 79 attributed to irq/NN-pciehp, zero AER errors (the
# drop was intentional), then Xid 154. The internal Turing 1650 never hit this
# because RTD3 reads "Not supported" on it.
#
# NVreg_DynamicPowerManagement=0 disarms the whole state machine (mode NEVER:
# CreateDynamicPowerCallbacks is never called, no timers). But getting that
# value to the driver is a trap in its own right, see write_modprobe_shadow().

# Effective DynamicPowerManagement value of the LOADED module. Empty if the
# driver is not loaded. This is the only number that matters: what is written in
# modprobe.d is irrelevant if the module was loaded from an initramfs built
# before the file existed.
nvidia_dpm_value() {
    grep -oP '^DynamicPowerManagement: \K[0-9]+' "$NV_PARAMS" 2>/dev/null
}

# Per-GPU runtime D3 status, from /proc/driver/nvidia/gpus/<bdf>/power.
# "Not supported" on the reference machine's Turing dGPU; the thing to check on
# an Ampere eGPU right after it binds.
nvidia_gpu_power_status() {
    local bdf=$1
    grep -m1 'Runtime D3 status' "$NV_GPUS_DIR/$bdf/power" 2>/dev/null | sed 's/.*: *//'
}

# Refuse to activate while the loaded driver still has RTD3 armed. Returns 0 if
# safe, 1 if not (and explains). This single check would have saved a day.
# ---------------------------------------------------------------- DRM layer
#
# nvidia_drm attaches to a hot-added GPU BY ITSELF. Journal, 2026-09-09 15:16
# (an `on --no-fbdev` run, modules resident, no modprobe in between):
#
#   248.766  nvidia 0000:01:00.0: enabling device          <- 3060 probed by the core
#   248.810  [nvidia-drm] [GPU ID 0x100] Loading driver   <- 44 ms later
#   250.942  Initialized nvidia-drm ... on minor 0
#   251.025  fb1: nvidia-drmdrmfb frame buffer device     <- fbdev=1: the flag did nothing
#   261.518  pciehp: Link Down
#
# nvidia-drm registers {probe, remove} callbacks with nvidia-modeset's KAPI
# (struct NvKmsKapiCallbacks, nvkms-kapi.h) and the core calls them at PCI
# probe/remove. So the display path comes up on the eGPU with whatever
# parameters nvidia_drm was LOADED with, and `modprobe nvidia_drm modeset=0`
# against a resident module is a no-op — exactly the RTD3 lesson again. Every
# `--no-fbdev` / `--no-kms` / `--modeset-safe` run before this discovery ran at
# the defaults. Those options now VERIFY the loaded values; `drm <mode>` sets
# them (modprobe.d + initramfs), reload-driver or a reboot applies them.

# Value of a loaded module parameter as the kernel reports it (Y/N for bools).
# Fails if the module is not loaded or the file is unreadable (they are 0400).
module_param() {
    local v; v=$(cat "$SYS_MODULE/$1/parameters/$2" 2>/dev/null) || return 1
    printf '%s\n' "$v"
}

# What the LOADED nvidia_drm will do to a GPU that appears on the bus.
#   full        modeset=1 fbdev=1  driver default: the configuration that died every run
#   nofbdev     modeset=1 fbdev=0  KMS, no framebuffer console
#   nokms       modeset=0          render node only, no display-engine bring-up
#   not-loaded  / unreadable       (parameters are root-only)
drm_layer_mode() {
    local m f
    [[ -d $SYS_MODULE/nvidia_drm ]] || { echo not-loaded; return 0; }
    m=$(module_param nvidia_drm modeset) || { echo unreadable; return 0; }
    f=$(module_param nvidia_drm fbdev)
    case "$m/$f" in
        N/*) echo nokms ;;
        Y/N) echo nofbdev ;;
        Y/Y) echo full ;;
        *)   echo "unknown($m/$f)" ;;
    esac
}

# Are nvidia_modeset's HDMI-FRL / VRR parameters all set (the `drm safe` set)?
modeset_safe_loaded() {
    local p
    for p in disable_hdmi_frl disable_vrr_memclk_switch conceal_vrr_caps; do
        [[ $(module_param nvidia_modeset "$p") == Y ]] || return 1
    done
    return 0
}

# ---------------------------------------------------------------- the NVKMS door
#
# With nvidia_drm modeset=0 nothing in the KERNEL allocates the eGPU's display
# engine — but userspace still can, through /dev/nvidia-modeset:
# NVKMS_IOCTL_ALLOC_DEVICE has no privilege check (nvkms.c, AllocDevice), and
# measured on 2026-09-09 21:00 on the internal 1650 with modeset=0 loaded:
#   - kwin_wayland allocates it 1.5 s after a GPU appears (its Vulkan probe of
#     the new device — it then rejects the device, but the engine is up);
#   - every PRIME client (vkcube, glxgears) allocates it once at start.
# On the eGPU that is the same display-engine bring-up that has died every
# time, just triggered from userspace. So the door is sealed: /dev/null is
# bind-mounted over the node. Clients still open it, every ioctl fails, and
# they carry on — vkcube, vulkaninfo and glxgears all ran normally with the
# allocation count flat (LD_PRELOAD-tested). What does NOT work is making the
# node unopenable (chmod 000 / absent): the Vulkan driver segfaults on that.
nvkms_door_sealed() { findmnt -n "$NVKMS_NODE" >/dev/null 2>&1; }
nvkms_node_holders() {
    local p f
    for p in /proc/[0-9]*; do
        for f in "$p"/fd/*; do
            [[ $(readlink "$f" 2>/dev/null) == "$NVKMS_NODE" ]] || continue
            printf '%s(%s) ' "${p#/proc/}" "$(cat "$p/comm" 2>/dev/null)"; break
        done
    done
}
seal_nvkms_door() {
    [[ -e $NVKMS_NODE ]] || { info "  $NVKMS_NODE absent (nvidia_modeset not loaded) — nothing to seal"; return 0; }
    if nvkms_door_sealed; then info "  $NVKMS_NODE already sealed"; return 0; fi
    local h; h=$(nvkms_node_holders)
    [[ -n $h ]] && warn "  already holding the REAL node open (a bind mount cannot take that away): $h"
    [[ $DRY_RUN -eq 1 ]] && { info "  would: mount --bind /dev/null $NVKMS_NODE"; return 0; }
    if mount --bind /dev/null "$NVKMS_NODE"; then
        ok "  sealed: $NVKMS_NODE is /dev/null until 'off' — no client can allocate the display engine"
    else
        warn "  mount --bind /dev/null $NVKMS_NODE failed"; return 1
    fi
}
unseal_nvkms_door() {
    nvkms_door_sealed || return 0
    [[ $DRY_RUN -eq 1 ]] && { info "  would: umount $NVKMS_NODE"; return 0; }
    if umount "$NVKMS_NODE" 2>/dev/null; then info "  unsealed $NVKMS_NODE"; else warn "  could not umount $NVKMS_NODE"; return 1; fi
}

# The option flags say what the DRM layer must be; refuse unless the loaded
# modules already are that. Nothing this script does at activation time can
# change it.
preflight_drm_layer() {
    local want='' have; have=$(drm_layer_mode)
    if [[ $NO_KMS -eq 1 ]]; then want=nokms
    elif [[ $NO_FBDEV -eq 1 || $MODESET_SAFE -eq 1 ]]; then want=nofbdev
    fi
    if [[ $have == not-loaded ]]; then
        info "nvidia_drm not loaded; it will take its parameters from modprobe.d when it loads"
        return 0
    fi
    if [[ $have == unreadable ]]; then
        warn "cannot read nvidia_drm's parameters (root only) — run this as root"
        return 1
    fi
    if [[ -n $want && $have != "$want" ]]; then
        local mode=$want; [[ $MODESET_SAFE -eq 1 ]] && mode=safe
        warn "nvidia_drm is loaded as '$have' but this run asks for '$want'."
        warn "A resident module ignores modprobe parameters, and nvidia_drm attaches"
        warn "to the eGPU by itself the moment it enumerates — so this run would"
        warn "silently test '$have'. (Every earlier --no-fbdev/--no-kms run did.)"
        warn ""
        warn "Set it, apply it, then retry:"
        warn "    $0 drm $mode"
        warn "    $0 reload-driver        (eGPU off; or reboot)"
        warn "    $0 drm status           -> must say '$want'"
        return 1
    fi
    if [[ $MODESET_SAFE -eq 1 ]] && ! modeset_safe_loaded; then
        warn "--modeset-safe asked, but nvidia_modeset is loaded without disable_hdmi_frl /"
        warn "disable_vrr_memclk_switch / conceal_vrr_caps. '$0 drm safe', then reload-driver."
        return 1
    fi
    case $have in
        nokms)   ok "nvidia_drm loaded with modeset=0: the eGPU gets a render node only, no display engine"
                 [[ $SEAL_NVKMS -eq 1 ]] || warn "--no-seal: a client (kwin does it in 1.5 s) can still bring the display engine up" ;;
        nofbdev) ok "nvidia_drm loaded with fbdev=0: KMS, but no framebuffer console on the eGPU" ;;
        full)    warn "nvidia_drm loaded at the defaults (modeset=1 fbdev=1): the configuration that has"
                 warn "died every run. Expected only if you are testing 'gsp off'. Otherwise:"
                 warn "    $0 drm nokms      (then reload-driver --force-kill)" ;;
    esac
    return 0
}

# Name of a live compositor / X server, if any. A graphical session opens the
# eGPU's KMS node the moment nvidia-drm registers it, and when the card dies
# the whole desktop freezes into garbage — the 19:30 run on 2026-09-09 ended in
# a power-cycle with no crash dump for exactly this reason.
desktop_is_live() {
    local c
    for c in kwin_wayland kwin_x11 gnome-shell Xorg sway Hyprland weston; do
        pgrep -x "$c" >/dev/null 2>&1 && { echo "$c"; return 0; }
    done
    return 1
}

preflight_rtd3() {
    local v; v=$(nvidia_dpm_value)
    if [[ -z $v ]]; then
        info "nvidia module not loaded; RTD3 check deferred to after the bind"
        return 0
    fi
    if [[ $v == 0 ]]; then
        ok "NVIDIA DynamicPowerManagement=0 (RTD3 disarmed) in the loaded module"
        return 0
    fi
    warn "NVIDIA DynamicPowerManagement=$v in the LOADED module. RTD3 is armed."
    warn ""
    warn "With this set, an Ampere-or-newer eGPU will drop its PCIe link exactly"
    warn "~10s after it goes idle (5s + 5s idle timer in the driver), pciehp will"
    warn "report Link Down, and you get Xid 79 then Xid 154. Every time."
    warn ""
    warn "Right now, no reboot (30s):   $0 reload-driver"
    warn "Permanently:                  $0 install-rules   then REBOOT"
    warn "      (writes the modprobe shadow, rebuilds the initramfs nvidia is baked into)"
    warn "Confirm either way with:      grep DynamicPowerManagement $NV_PARAMS  -> 0"
    warn ""
    warn "Do not activate until it does. Override with --ignore-rtd3 if you are"
    warn "deliberately reproducing the failure."
    return 1
}

# Is nvidia baked into the initramfs? If so, modprobe.d changes do nothing until
# the image is rebuilt: the module loads before switch-root with whatever config
# the image was built with. On CachyOS this comes from chwd via
# /etc/mkinitcpio.conf.d/10-chwd.conf, which is easy to miss when the main file
# says MODULES=().
initramfs_has_nvidia() {
    local f
    for f in "$MKINITCPIO_CONF" "$MKINITCPIO_D"/*.conf; do
        [[ -r $f ]] || continue
        grep -E '^[[:space:]]*MODULES(\+?=)' "$f" 2>/dev/null | grep -q 'nvidia' && return 0
    done
    return 1
}

# Write /etc/modprobe.d/nvidia.conf so that it SHADOWS the distro's copy.
#
# Why a shadow and not a new file: modprobe sorts all config files
# lexicographically regardless of directory, and '-' sorts before '.', so
# nvidia-anything.conf loses to nvidia.conf. Worse, a later-sorting duplicate
# (zz-*.conf) did NOT win either on 2026-09-09; the second assignment was
# ignored. Only a same-named file in /etc replaces the /usr/lib one outright.
#
# Preserves every other option the distro file sets (a CachyOS file also sets
# InitializeSystemMemoryAllocations), only forcing DynamicPowerManagement=0.
# Prints the generated content; writes it if $2 is 'write'.
write_modprobe_shadow() {
    local out=$1 mode=${2:-print}
    local opts=''
    if [[ -r $DISTRO_MODPROBE ]]; then
        # Join continuation lines, keep every NVreg_ option except DPM.
        opts=$(sed -e ':a' -e '/\\$/N; s/\\\n//; ta' "$DISTRO_MODPROBE" \
               | grep -E '^[[:space:]]*options[[:space:]]+nvidia[[:space:]]' \
               | sed -E 's/^[[:space:]]*options[[:space:]]+nvidia[[:space:]]+//' \
               | tr ' ' '\n' | grep -E '^NVreg_' | grep -v '^NVreg_DynamicPowerManagement=' \
               | tr '\n' ' ')
    fi
    local content
    content=$(cat <<EOF
# Written by xgm-egpu install-rules. Shadows $DISTRO_MODPROBE by name.
#
# The distro file enables NVIDIA runtime power management (RTD3) so a notebook
# dGPU can power itself down when idle. Correct for an internal GPU; fatal for
# an XG Mobile eGPU: in FINE mode the driver drops the card's PCIe link ~10s
# after idle, pciehp sees Link Down, and the GPU is gone (Xid 79 -> Xid 154).
#
# Every other option from the distro file is preserved below. Only
# NVreg_DynamicPowerManagement is forced to 0 (NEVER).
#
# If nvidia is in your initramfs this file does nothing until you rebuild it
# (mkinitcpio -P) and reboot. Verify with:
#   grep DynamicPowerManagement /proc/driver/nvidia/params   -> 0
options nvidia ${opts}NVreg_DynamicPowerManagement=0
EOF
)
    if [[ $mode == write ]]; then
        printf '%s\n' "$content" > "$out"
    else
        printf '%s\n' "$content"
    fi
}

# Save/restore /sys/bus/pci/drivers_autoprobe. Needed for --no-reload to mean
# anything: skipping our own modprobe is pointless when the nvidia module is
# already resident, because the kernel auto-binds it to the new device the
# moment it enumerates (observed 2026-09-09, which invalidated a test).
_AUTOPROBE_SAVED=
autoprobe_disable() {
    [[ -w $AUTOPROBE ]] || { warn "cannot write $AUTOPROBE"; return 1; }
    _AUTOPROBE_SAVED=$(cat "$AUTOPROBE" 2>/dev/null)
    [[ $DRY_RUN -eq 1 ]] && return 0
    echo 0 > "$AUTOPROBE" && info "  drivers_autoprobe=0 (new devices will NOT be bound)"
}
autoprobe_restore() {
    [[ -n $_AUTOPROBE_SAVED && -w $AUTOPROBE ]] || return 0
    [[ $DRY_RUN -eq 1 ]] && return 0
    echo "$_AUTOPROBE_SAVED" > "$AUTOPROBE" && info "  drivers_autoprobe restored to $_AUTOPROBE_SAVED"
    _AUTOPROBE_SAVED=
}

# DRM's connector hotplug poll (drivers/gpu/drm/drm_probe_helper.c):
#   #define DRM_OUTPUT_POLL_PERIOD (10*HZ)
# Ten seconds after a DRM device registers, and every ten seconds after, it
# calls each connector's detect(). For nvidia-drm that goes through
# nvidia-modeset and out to the GPU as a GSP RPC. On 2026-09-09 the bisection
# showed: nvidia core alone survives; add nvidia_modeset+nvidia_drm and the
# link dies at ~10s, with "Correcting number of heads" as the last line and a
# GSP_RM_CONTROL in flight. Hypothesis: that poll's detect() is the killer.
# Test: disable the poll BEFORE nvidia_drm registers, so it never starts.
_DRM_POLL_SAVED=
drm_poll_disable() {
    [[ -w $DRM_POLL ]] || { warn "cannot write $DRM_POLL (drm_kms_helper not loaded?)"; return 1; }
    _DRM_POLL_SAVED=$(cat "$DRM_POLL" 2>/dev/null)
    [[ $DRY_RUN -eq 1 ]] && return 0
    echo 0 > "$DRM_POLL" && info "  drm_kms_helper.poll=0 (connector hotplug poll disabled)"
}
drm_poll_restore() {
    [[ -n $_DRM_POLL_SAVED && -w $DRM_POLL ]] || return 0
    [[ $DRY_RUN -eq 1 ]] && return 0
    echo "$_DRM_POLL_SAVED" > "$DRM_POLL" && info "  drm_kms_helper.poll restored to $_DRM_POLL_SAVED"
    _DRM_POLL_SAVED=
}

cmd_preflight() {
    check_interface
    echo "RTD3 (NVIDIA dynamic power management):"
    local v; v=$(nvidia_dpm_value)
    printf '  %-28s %s\n' "loaded-module value" "${v:-<nvidia not loaded>}"
    printf '  %-28s %s\n' "would-load value" "$(modprobe --show-depends nvidia 2>/dev/null | tr ' ' '\n' | grep -oP 'NVreg_DynamicPowerManagement=\K\S+' | tail -1)"
    printf '  %-28s %s\n' "nvidia in initramfs" "$(initramfs_has_nvidia && echo yes || echo no)"
    printf '  %-28s %s\n' "shadow file present" "$([[ -f $ETC_MODPROBE_D/nvidia.conf ]] && echo yes || echo no)"
    local g
    for g in "$NV_GPUS_DIR"/*/; do
        [[ -d $g ]] && printf '  %-28s %s\n' "$(basename "$g") runtime D3" "$(nvidia_gpu_power_status "$(basename "$g")")"
    done
    echo
    echo "DRM layer (what nvidia_drm does to the eGPU when it appears — see 'drm status'):"
    local m; m=$(module_param nvidia_drm modeset 2>/dev/null || true)
    if [[ -z $m ]]; then
        printf '  %-28s %s\n' "loaded nvidia_drm" "$([[ $(drm_layer_mode) == not-loaded ]] && echo 'not loaded' || echo 'parameters unreadable — run as root')"
    else
        printf '  %-28s %s\n' "loaded nvidia_drm" "modeset=$m fbdev=$(module_param nvidia_drm fbdev 2>/dev/null || true) -> $(drm_layer_mode)"
    fi
    printf '  %-28s %s\n' "config file" "$([[ -f $DRM_CONF ]] && tr '\n' ';' < "$DRM_CONF" || echo 'none (driver defaults: modeset=1 fbdev=1)')"
    echo
    preflight_rtd3
}

# Sample the eGPU's power state every 0.5s so a link death shows exactly what
# changed. Integer arithmetic only: this machine is fr_FR and printf %f wants a
# comma, which bit the first version of this.
cmd_watch() {
    local secs=${1:-40} out=${2:-/tmp/xgm-watch.log}
    export LC_ALL=C
    need_root_port
    local gpu; gpu=$(egpu_bdf || echo "")
    local aud=${gpu%.*}.1
    r() { cat "/sys/bus/pci/devices/$1/$2" 2>/dev/null || echo '-'; }
    : > "$out"
    {
      echo "time  port_ctl port_rt   gpu_ctl gpu_rt    aud_ctl aud_rt    link      dpm  rtd3"
      local i n=$(( secs * 2 ))
      for ((i=0; i<n; i++)); do
        printf '%2d.%d  %-8s %-9s %-7s %-9s %-7s %-9s %-9s %-4s %s\n' \
          $(( i / 2 )) $(( (i % 2) * 5 )) \
          "$(r "$ROOT_PORT" power/control)" "$(r "$ROOT_PORT" power/runtime_status)" \
          "$(r "$gpu" power/control)"       "$(r "$gpu" power/runtime_status)" \
          "$(r "$aud" power/control)"       "$(r "$aud" power/runtime_status)" \
          "$(r "$ROOT_PORT" current_link_speed | tr -d ' ')" \
          "$(nvidia_dpm_value)" "$(nvidia_gpu_power_status "$gpu")"
        sleep 0.5
      done
      echo; echo "--- kernel log tail ---"; dmesg 2>/dev/null | tail -30
    } >> "$out" 2>&1
    ok "saved to $out"
}

# Open references on the nvidia module beyond its dependent modules. From the
# handoff notes: refcnt == (open fds) + (number of modules in holders/). Anything
# above the holders count is a process with /dev/nvidia* open, which would make
# a reload fail or, worse, stall. Prints the extra count; 0 means safe.
nvidia_extra_refs() {
    local rc h
    rc=$(cat "$SYS_MODULE/nvidia/refcnt" 2>/dev/null) || { echo 0; return 1; }
    h=$(ls "$SYS_MODULE/nvidia/holders" 2>/dev/null | wc -l)
    echo $(( rc - h ))
}

# Is a PCI device still answering? A device that has "fallen off the bus" keeps
# its sysfs directory for a while, but config-space reads return nothing, so
# current_link_speed comes back empty. That is the zombie state observed after
# every 10-second death.
device_alive() {
    local d=$SYSFS_PCI/$1
    [[ -e $d ]] || return 1
    [[ -n $(cat "$d/current_link_speed" 2>/dev/null) ]]
}

# Reload the NVIDIA stack on the running system so a new modprobe.d value takes
# effect without a reboot and without depending on the initramfs at all. Only
# safe when nothing holds the GPU; refuses otherwise. This is NOT the fatal
# "--release unload" path: nothing is switching, egpu_enable is untouched, the
# bus is static. It is a plain driver reload on an idle internal dGPU.
cmd_reload_driver() {
    need_root; check_interface
    [[ $(read_attr "$ATTR_ENABLE") == 0 ]] || die "egpu_enable is 1 — reload the driver only with the eGPU OFF"
    unseal_nvkms_door

    # A browser with GPU acceleration is enough to block the unload. --force-kill
    # applies here too, or nothing that follows `drm <mode>` can be applied
    # without a reboot.
    local h; h=$(nv_holders)
    if [[ -n $h && $FORCE_KILL -eq 1 ]]; then
        warn "--force-kill: killing what holds /dev/nvidia*:"
        printf '    %s\n' "$h" >&2
        kill_nv_holders "$h"
    fi
    local extra; extra=$(nvidia_extra_refs)
    if (( extra > 0 )); then
        warn "nvidia has $extra reference(s) beyond its dependent modules — something holds /dev/nvidia*:"
        nv_holders | sed 's/^/    /' >&2
        die "close those first (or: systemctl stop sddm), or re-run with --force-kill"
    fi
    h=$(nv_holders)
    [[ -z $h ]] || die "processes hold /dev/nvidia* (close them, or --force-kill):\n$h"

    local before; before=$(nvidia_dpm_value)
    info "loaded DynamicPowerManagement=${before:-<not loaded>}; would-load: $(modprobe --show-depends nvidia 2>/dev/null | tr ' ' '\n' | grep -oP 'NVreg_DynamicPowerManagement=\K\S+' | tail -1)"
    [[ $DRY_RUN -eq 1 ]] && { ok "dry run — would unload nvidia_drm nvidia_modeset nvidia_uvm nvidia and reload"; return 0; }

    local m attempt
    for m in nvidia_drm nvidia_modeset nvidia_uvm nvidia; do
        grep -q "^$m " /proc/modules 2>/dev/null || continue
        for attempt in 1 2 3 4 5; do
            modprobe -r "$m" 2>/dev/null && break
            sleep 1
        done
        grep -q "^$m " /proc/modules 2>/dev/null && die "could not unload $m (refcnt $(cat "$SYS_MODULE/$m/refcnt" 2>/dev/null))"
        info "  unloaded $m"
    done
    modprobe nvidia         || die "modprobe nvidia failed"
    modprobe nvidia_modeset || warn "modprobe nvidia_modeset failed"
    modprobe nvidia_uvm     || warn "modprobe nvidia_uvm failed"
    modprobe nvidia_drm     || warn "modprobe nvidia_drm failed"
    sleep 1

    local after; after=$(nvidia_dpm_value)
    info "loaded DynamicPowerManagement is now: ${after:-?}"
    info "DRM layer now: $(drm_layer_mode)  (nvidia_drm modeset=$(module_param nvidia_drm modeset 2>/dev/null || echo '?') fbdev=$(module_param nvidia_drm fbdev 2>/dev/null || echo '?'); nvidia_modeset safe set: $(modeset_safe_loaded && echo yes || echo no))"
    if [[ $after == 0 ]]; then
        ok "RTD3 disarmed in the running driver. No reboot needed for the test."
        ok "(For persistence across reboots you still need install-rules + the initramfs rebuild.)"
    else
        die "still $after after reload. The value on the modprobe line is not reaching the driver.
     Check:  modprobe -c | grep -i 'options nvidia'   and   $0 preflight"
    fi
}

# Bind one layer of the driver stack to an already-enumerated eGPU and watch
# whether the link survives. This is the bisection tool for the 2026-09-09
# result: with drivers_autoprobe=0 an UNBOUND card holds Gen3 x8 indefinitely,
# while every run with the full stack bound died at exactly 10s.
#
#   core   nvidia only, display path unloaded first
#          -> survives: the display path is the killer
#          -> dies:     the core module is (GSP init is the suspect)
#   drm    reload nvidia_modeset + nvidia_drm on top of a bound core
#   audio  snd_hda_intel on the HDMI function only
#   all    the whole stack, i.e. what `on` used to do
cmd_bind() {
    need_root
    local what=${1:-core} m
    local bdf; bdf=$(egpu_bdf) || die "no eGPU on the bus — run '$0 on --no-reload' first"
    local aud=${bdf%.*}.1
    device_alive "$bdf" || die "$bdf is already off the bus"

    # These rungs only mean something on a FRESH load: a resident nvidia_drm
    # keeps the parameters it booted with and has already attached to the eGPU.
    case $what in
      drm|drm-nokms|drm-nofbdev)
        if [[ -d $SYS_MODULE/nvidia_drm ]]; then
            die "nvidia_drm is already loaded ($(drm_layer_mode)) — this rung would silently test that,
     not '$what'. Run '$0 bind core' first (it unloads the display path), or set the
     layer persistently with '$0 drm <mode>' + reload-driver and use '$0 on'."
        fi ;;
    esac

    case $what in
      core)
        info "unloading the display path so only the core module binds"
        [[ $DRY_RUN -eq 1 ]] || modprobe -r nvidia_drm nvidia_modeset nvidia_uvm 2>/dev/null || true
        for m in nvidia_drm nvidia_modeset; do
            grep -q "^$m " /proc/modules 2>/dev/null && warn "  $m still loaded — result will be ambiguous"
        done
        info "binding nvidia to $bdf"
        [[ $DRY_RUN -eq 1 ]] || { modprobe nvidia 2>/dev/null || true
            echo "$bdf" > /sys/bus/pci/drivers/nvidia/bind 2>/dev/null || warn "  bind write failed (already bound?)"; }
        ;;
      modeset)
        info "loading nvidia_modeset ONLY (no nvidia_drm: no DRM device, no fbdev, no DRM clients)"
        [[ $DRY_RUN -eq 1 ]] || modprobe nvidia_modeset
        ;;
      drm-nokms)
        info "loading nvidia_modeset + nvidia_drm with modeset=0 (render node only, no KMS)"
        [[ $DRY_RUN -eq 1 ]] || { modprobe nvidia_modeset; modprobe nvidia_drm modeset=0; }
        ;;
      drm-nofbdev)
        info "loading nvidia_modeset + nvidia_drm modeset=1 fbdev=0 (KMS, but no framebuffer console)"
        [[ $DRY_RUN -eq 1 ]] || { modprobe nvidia_modeset; modprobe nvidia_drm modeset=1 fbdev=0; }
        ;;
      drm)
        [[ $NO_DRM_POLL -eq 1 ]] && drm_poll_disable
        info "loading nvidia_modeset + nvidia_drm on top of the bound core"
        [[ $DRY_RUN -eq 1 ]] || { if [[ $MODESET_SAFE -eq 1 ]]; then modprobe nvidia_modeset disable_hdmi_frl=1 disable_vrr_memclk_switch=1 conceal_vrr_caps=1; else modprobe nvidia_modeset; fi; modprobe nvidia_drm; }
        ;;
      audio)
        info "binding snd_hda_intel to the HDMI audio function $aud"
        [[ $DRY_RUN -eq 1 ]] || { modprobe snd_hda_intel 2>/dev/null || true
            echo "$aud" > /sys/bus/pci/drivers/snd_hda_intel/bind 2>/dev/null || warn "  bind write failed"; }
        ;;
      all)
        [[ $NO_DRM_POLL -eq 1 ]] && drm_poll_disable
        info "binding the whole stack"
        [[ $DRY_RUN -eq 1 ]] || { modprobe nvidia
            echo "$bdf" > /sys/bus/pci/drivers/nvidia/bind 2>/dev/null || true
            modprobe nvidia_modeset; modprobe nvidia_uvm; modprobe nvidia_drm
            modprobe snd_hda_intel 2>/dev/null || true
            echo "$aud" > /sys/bus/pci/drivers/snd_hda_intel/bind 2>/dev/null || true; }
        ;;
      *) die "unknown bind target '$what' (core|modeset|drm-nokms|drm-nofbdev|drm|audio|all)" ;;
    esac
    [[ $DRY_RUN -eq 1 ]] && { ok "dry run — nothing bound"; return 0; }

    printf '  driver on %s: %s\n' "$bdf" "$(basename "$(readlink -f "/sys/bus/pci/devices/$bdf/driver" 2>/dev/null)" 2>/dev/null || echo none)"
    [[ $MASK_PCIEHP -eq 1 ]] && { pciehp_mask && trap pciehp_restore EXIT; }
    # Every activation is a potential hang, and every hang so far that was not
    # armed left nothing on disk. So arm the capture here, unconditionally,
    # instead of relying on a separate command being remembered (2026-09-09).
    if [[ $AUTO_CAPTURE -eq 1 ]]; then
        info "Arming hang capture (automatic; --no-capture to skip)"
        capture_arm || warn "  capture partially armed — see above"
        capture_netconsole || true
    fi

    info "Watching the link for ${SURVIVAL_SECS}s, and who opens the display nodes..."
    # On 2026-09-09 "Correcting number of heads" printed a SECOND time at +9s,
    # i.e. something re-allocated the NVKMS device right before the death. Log
    # every process holding /dev/nvidia-modeset or a DRM node each second so a
    # late client (plymouth, a udev helper, a compositor) shows up by name.
    local t alive=1 prev='' cur
    for ((t=1; t<=SURVIVAL_SECS; t++)); do
        sleep 1
        device_alive "$bdf" || { alive=0; break; }
        cur=$(fuser /dev/nvidia-modeset /dev/dri/card* /dev/dri/renderD* 2>/dev/null | tr -s ' ' | xargs -r -n1 ps -o comm= -p 2>/dev/null | sort -u | tr '\n' ' ')
        if [[ $cur != "$prev" ]]; then
            info "  ${t}s: display-node holders: ${cur:-none}"
            prev=$cur
        elif (( t % 5 == 0 )); then
            info "  ${t}s: still up"
        fi
    done
    if (( alive )); then
        ok "LINK SURVIVED ${SURVIVAL_SECS}s with '$what' bound."
        save_kernel_log 150
        cmd_link "$bdf"
    else
        warn "link DIED at ~${t}s with '$what' bound. That layer is implicated."
        dmesg 2>/dev/null | grep -iE 'Link Down|Xid|NVRM' | tail -6 | sed 's/^/    /' >&2
        save_kernel_log 600
        collect_gpu_crash_dump || true
        death_recovery_hint
        return 1
    fi
}

# PCIe Slot Control (CAP_EXP+0x18): bit3 Presence Detect Changed Enable,
# bit5 Hot-Plug Interrupt Enable, bit12 Data Link Layer State Changed Enable.
# Clearing them stops pciehp reacting to a Link Down. Every death so far has
# Xid 79 attributed to irq/NN-pciehp: pciehp saw the link drop and tore the
# device down. If the drop is momentary (a retrain, a PHY power event) this
# turns "GPU has fallen off the bus" into a hiccup. If the link genuinely
# stays down the device just goes unresponsive instead, which the watch
# detects anyway. Reverted on exit. Surprise-unplug is not detected while
# masked; use `xgm-egpu off` to detach, which is a proper ACPI eject.
PCIEHP_MASK_BITS=0x1028
_SLOTCTL_SAVED=
pciehp_mask() {
    need_root_port
    command -v setpci >/dev/null 2>&1 || { warn "setpci not installed (pciutils)"; return 1; }
    local v; v=$(setpci -s "$ROOT_PORT" CAP_EXP+18.w 2>/dev/null) || { warn "cannot read Slot Control on $ROOT_PORT"; return 1; }
    _SLOTCTL_SAVED=$v
    local new; new=$(printf '%04x' $(( 0x$v & ~PCIEHP_MASK_BITS )))
    [[ $DRY_RUN -eq 1 ]] && { info "  would set Slot Control $v -> $new"; return 0; }
    setpci -s "$ROOT_PORT" CAP_EXP+18.w="$new" && info "  pciehp masked on $ROOT_PORT (Slot Control $v -> $new)"
}
pciehp_restore() {
    [[ -n $_SLOTCTL_SAVED ]] || return 0
    [[ $DRY_RUN -eq 1 ]] && return 0
    setpci -s "$ROOT_PORT" CAP_EXP+18.w="$_SLOTCTL_SAVED" 2>/dev/null && info "  pciehp restored on $ROOT_PORT ($_SLOTCTL_SAVED)"
    _SLOTCTL_SAVED=
}

# One line of GPU state, for the survival watch. Empty if nvidia-smi cannot
# talk to the card (unbound, or gone).
smi_line() {
    command -v nvidia-smi >/dev/null 2>&1 || return 0
    nvidia-smi --query-gpu=pstate,clocks.sm,clocks.mem,power.draw,pcie.link.gen.current,temperature.gpu \
        --format=csv,noheader,nounits 2>/dev/null | head -1 | grep -E '^P[0-9]' || true
}

# Clamp the GPU to its floor before the display engine powers up. -lgc pins the
# graphics clock low (the big transient), -pl drops the sustained power limit.
# Both need the core driver bound and the card responsive, which it is right
# after `modprobe nvidia` (core alone survives indefinitely). nvidia-smi clamps
# out-of-range values itself; we just ask for the floor and log what took.
cap_gpu_power() {
    command -v nvidia-smi >/dev/null 2>&1 || { warn "nvidia-smi absent; cannot cap power"; return 1; }
    local bdf=$1
    [[ $DRY_RUN -eq 1 ]] && { info "  would: nvidia-smi -pm 1; -lgc 0,405; -pl <min>"; return 0; }
    nvidia-smi -i "$bdf" -pm 1 >/dev/null 2>&1 || true
    # Lock graphics clock to a low band. 405 MHz is a safe floor across Ampere.
    if nvidia-smi -i "$bdf" -lgc 0,405 >/dev/null 2>&1; then
        info "  locked graphics clock to <=405 MHz"
    else
        warn "  -lgc not supported here; trying -lmc / -pl only"
    fi
    # Lowest allowed power limit, read from the card.
    local minpl
    minpl=$(nvidia-smi -i "$bdf" -q -d POWER 2>/dev/null | grep -iE 'Min Power Limit' | head -1 | grep -oE '[0-9]+' | head -1)
    if [[ -n $minpl ]]; then
        nvidia-smi -i "$bdf" -pl "$minpl" >/dev/null 2>&1 && info "  set power limit to ${minpl} W (floor)"
    fi
    info "  now: $(smi_line)"
}

# ---------------------------------------------------------------- hang capture
#
# 2026-09-09 14:48: the --cap-power run reached 7s with the card flat at 23 W,
# then the WHOLE MACHINE hard-hung. The journal for that boot is hard-cut with no
# shutdown lines and the next boot ran F2FS recovery. Nothing about the death
# reached disk, and nothing ever has: pstore is not mounted, there is no ramoops,
# and kernel.nmi_watchdog=0 so an IRQs-off lockup is undetectable by design.
#
# `capture` arms the kernel so the next hang becomes a PANIC WITH A BACKTRACE
# written to EFI-backed pstore (survives the reboot), and optionally streams
# kernel messages live to the Pi over netconsole. All runtime; no reboot to arm.
CAPTURE_SYSCTLS=(
    kernel.nmi_watchdog=1          # hard-lockup detector (perf NMI) — catches IRQs-off hangs
    kernel.hardlockup_panic=1
    kernel.softlockup_panic=1
    kernel.hung_task_panic=1       # D-state > hung_task_timeout -> panic (cf. the eject wedges)
    kernel.hung_task_timeout_secs=30   # default 120 is too slow for a wedged eject
    kernel.panic_on_oops=1
    kernel.panic_on_rcu_stall=1
    kernel.panic=30                # come back on its own 30s after the panic
)
capture_arm() {
    need_root
    local kv k v rc=0
    for kv in "${CAPTURE_SYSCTLS[@]}"; do
        k=${kv%%=*}; v=${kv#*=}
        if [[ $DRY_RUN -eq 1 ]]; then info "  would set $k=$v"; continue; fi
        if sysctl -qw "$k=$v" 2>/dev/null; then
            info "  $k=$(sysctl -n "$k" 2>/dev/null)"
        else
            warn "  could not set $k"; rc=1
        fi
    done
    # CONFIG_EFI_VARS_PSTORE_DEFAULT_DISABLE=y on this kernel: the EFI backend is
    # built in but OFF until this parameter is cleared. Mounting pstore without
    # this looks armed and records nothing — the same fail-open shape as the
    # lsof guard. Flip it, then verify a backend is actually registered.
    if [[ -e $EFI_PSTORE_DISABLE ]]; then
        if [[ $DRY_RUN -eq 1 ]]; then info "  would write 0 > $EFI_PSTORE_DISABLE"
        elif echo 0 > "$EFI_PSTORE_DISABLE" 2>/dev/null; then info "  efi_pstore enabled (pstore_disable=0)"
        else warn "  could not enable efi_pstore via $EFI_PSTORE_DISABLE"; rc=1; fi
    else
        warn "  $EFI_PSTORE_DISABLE absent — efi_pstore may be disabled; add efi_pstore.pstore_disable=0 to the kernel cmdline"
    fi
    if ! mountpoint -q "$PSTORE" 2>/dev/null; then
        if [[ $DRY_RUN -eq 1 ]]; then info "  would mount pstore at $PSTORE"
        elif mount -t pstore pstore "$PSTORE" 2>/dev/null; then info "  pstore mounted at $PSTORE (backend: $(cat /sys/module/pstore/parameters/backend 2>/dev/null))"
        else warn "  could not mount pstore at $PSTORE"; rc=1; fi
    else
        info "  pstore already mounted at $PSTORE"
    fi
    # The mount succeeding is not the same as a backend being able to record.
    # The kernel prints a NULL backend as the literal string "(null)".
    local be; be=$(cat /sys/module/pstore/parameters/backend 2>/dev/null)
    [[ $be == "(null)" ]] && be=""
    if [[ $DRY_RUN -eq 0 && -z $be ]]; then
        warn "  pstore has NO backend registered — a panic would write nothing."
        warn "  netconsole to the Pi is then the only capture; make sure it says armed below."
        rc=1
    elif [[ -n $be ]]; then
        info "  pstore backend: $be"
    fi
    return $rc
}
capture_netconsole() {
    local src dev
    src=$(ip -4 route get "$NETCONSOLE_TARGET" 2>/dev/null | grep -oE 'src \S+' | awk '{print $2}')
    dev=$(ip -4 route get "$NETCONSOLE_TARGET" 2>/dev/null | grep -oE 'dev \S+'  | awk '{print $2}')
    [[ -n $src && -n $dev ]] || { warn "  no route to $NETCONSOLE_TARGET; skipping netconsole"; return 1; }
    [[ $DRY_RUN -eq 1 ]] && { info "  would: modprobe netconsole netconsole=6666@$src/$dev,6666@$NETCONSOLE_TARGET/"; return 0; }
    if modprobe netconsole "netconsole=6666@$src/$dev,6666@$NETCONSOLE_TARGET/" 2>/dev/null; then
        info "  netconsole -> $NETCONSOLE_TARGET:6666 via $dev (wifi netpoll is best-effort)"
        info "  on the Pi, run:   nc -ul 6666 | tee -a ~/xgm-netconsole.log"
    else
        warn "  netconsole refused on $dev (driver may lack netpoll); pstore still armed"
        return 1
    fi
}
cmd_capture() {
    case ${1:-arm} in
      arm)
        info "Arming hang capture (hang -> panic -> backtrace in EFI pstore)"
        capture_arm || warn "capture partially armed — see above"
        capture_netconsole || true
        echo
        ok "armed. ('on' and 'bind' do this by themselves now.) If the machine hangs"
        ok "it will panic and reboot itself in ~30s; afterwards:   $0 capture read"
        ;;
      read)
        if ! ls "$PSTORE"/* >/dev/null 2>&1; then
            [[ -d $PSTORE ]] || { info "$PSTORE does not exist"; return 1; }
            info "no records in $PSTORE (no panic since arming, or pstore not mounted at boot)"
            info "try:  mount -t pstore pstore $PSTORE   then re-run"
            return 1
        fi
        local f
        for f in "$PSTORE"/*; do
            echo "=== $f ==="; cat "$f" 2>/dev/null; echo
        done
        ok "records above. Copy them somewhere before they are cleared:  cp $PSTORE/* ~/"
        ;;
      *) die "usage: $0 capture [arm|read]" ;;
    esac
}

# ---------------------------------------------------------------- death hook
#
# Every death prints: "NVRM: A GPU crash dump has been created. If possible,
# please run nvidia-bug-report.sh as root to collect this data before the
# NVIDIA kernel module is unloaded." That dump is the GPU side's own account
# of why it stopped answering — GSP logs, RPC history, the fault it saw — and
# it lives only in the driver's memory. Every reboot so far has destroyed it.
#
# The kernel is ALIVE at the moment the watch detects death (2026-09-09: the
# breadcrumb fsynced and the journal flushed after Xid 79; what "hangs" is the
# compositor and fbcon, not the kernel). So collect it right then, before any
# teardown, and before the user reaches for the power button.
collect_gpu_crash_dump() {
    local tag; tag=$(date +%Y%m%d-%H%M%S)
    # NO .gz here: the script appends .gz itself ("the file will automatically
    # be compressed to <file>.gz"). Passing foo.log.gz made it write
    # foo.log.gz.gz and the check below looked at the wrong name — 2026-09-09,
    # a real crash dump was lost to that.
    local base="$BUGREPORT_DIR/xgm-bugreport-$tag.log"
    local errlog="$BUGREPORT_DIR/xgm-bugreport-$tag.stderr"
    local script; script=$(command -v nvidia-bug-report.sh 2>/dev/null) || { warn "nvidia-bug-report.sh not installed; crash dump not collected"; return 1; }
    [[ $DRY_RUN -eq 1 ]] && { info "  would run: $script --safe-mode --output-file $base  (-> $base.gz)"; return 0; }
    info "Collecting NVIDIA's crash dump NOW (kernel is alive, module still loaded)"
    info "  this takes 10-40s; the screen may look frozen — it is not the kernel."
    # --safe-mode swaps nvidia-debugdump -D (live GPU queries that hang on a card
    # that is off the bus) for --ioctl --nvlogonly, which pulls the stored log
    # via ioctl. Keep stderr this time so a failure is diagnosable.
    ( cd "$BUGREPORT_DIR" && "$script" --safe-mode --output-file "$base" >"$errlog" 2>&1 ) || true
    sync
    local out=""
    for cand in "$base.gz" "$base" "$BUGREPORT_DIR/nvidia-bug-report.log.gz" "$BUGREPORT_DIR/nvidia-bug-report.log"; do
        [[ -s $cand ]] && { out=$cand; break; }
    done
    if [[ -n $out ]]; then
        [[ $out != "$base.gz" && $out != "$base" ]] && { mv -f "$out" "$base.gz" 2>/dev/null && out="$base.gz"; }
        rm -f "$errlog"
        ok "crash dump saved: $out  ($(du -h "$out" | cut -f1))"
        ok "survives reboot. Paste:  zcat $out | grep -nA40 'GPU crash dump\|Xid' | head -150"
    else
        warn "nvidia-bug-report.sh produced no file. Its output is in: $errlog"
        tail -5 "$errlog" 2>/dev/null | sed 's/^/    /' >&2
        return 1
    fi
}

# What to tell a user whose screen just froze: the machine is up.
death_recovery_hint() {
    local who=${SUDO_USER:-$(id -un)}
    local ip; ip=$(ip -4 addr show wlan0 2>/dev/null | grep -oE 'inet [0-9.]+' | awk '{print $2}')
    warn ""
    warn "The kernel is still running; the display stack is what froze. To get"
    warn "back WITHOUT a reboot (from this TTY, or ssh ${who}@${ip:-<this-ip>}):"
    warn "    1. UNPLUG the dock   ('off' returns EBUSY while it is attached)"
    warn "    2. sudo xgm-egpu off"
    warn "If that does not bring the desktop back, rebooting is fine — the crash"
    warn "dump above is already on disk and survives it."
    [[ -n $RUN_LOG ]] && warn "This whole run, plus the kernel log, is in: $RUN_LOG  (xgm-egpu logs)"
}

# ---------------------------------------------------------------- GSP firmware
#
# Strongest lead as of 2026-09-09. Every death dump shows GSP RPCs in flight
# (GSP_RM_CONTROL, GSP_RUN_CPU_SEQUENCER, UCODE_LIBOS_PRINT), and with pciehp
# masked the driver saw the GPU stop answering (Xid 79) BEFORE Link Down — a
# GPU that goes unresponsive while sitting in a stable P-state, mid-GSP-RPC, is
# a GSP firmware hang, not a link or power event. GSP failure on Ampere laptop
# GPUs is a documented class (open-gpu-kernel-modules issues #1058, #543).
#
# NVreg_EnableGpuFirmware=0 forces the driver off GSP onto the legacy CPU-side
# RM, which runs display init through an entirely different path. It works ONLY
# on the proprietary module — the open kernel modules require GSP and ignore the
# parameter (README/gsp.html). This machine is proprietary, so it is available.
#
# The differential fits: core-only survives (basic GSP RPCs are fine), the
# display path dies (a display GSP RPC falls over ~8s in). GSP-off changes that
# path wholesale.

nv_is_open() {
    # Open kernel module reports "Open Kernel Module" in its version string, and
    # a Dual MIT/GPL license. Proprietary reports neither.
    grep -qi 'open kernel module' "$NV_VERSION" 2>/dev/null && return 0
    [[ $(modinfo -F license nvidia 2>/dev/null) == *MIT* ]] && return 0
    return 1
}

cmd_gsp() {
    local sub=${1:-status}
    case $sub in
      status)
        printf '  driver: %s\n' "$(nv_is_open && echo 'OPEN kernel module (GSP is MANDATORY — cannot disable)' || echo 'proprietary (GSP can be disabled)')"
        printf '  EnableGpuFirmware (loaded): %s  ' "$(grep -oP 'EnableGpuFirmware: \K[0-9]+' "$NV_PARAMS" 2>/dev/null)"
        printf '(0=off, 0x12=18=default-on)\n'
        local g
        for g in "$NV_GPUS_DIR"/*/information; do
            [[ -r $g ]] && printf '  %s\n' "$(grep -i 'GPU Firmware' "$g" 2>/dev/null | sed 's/\s\+/ /g')"
        done
        printf '  shadow file: %s\n' "$([[ -f $GSP_CONF ]] && echo "$GSP_CONF (GSP forced OFF at next load)" || echo 'none (GSP at driver default)')"
        ;;
      off)
        need_root
        if nv_is_open; then
            die "this is the OPEN kernel module, which REQUIRES GSP — the parameter is ignored.
     To try GSP-off you must switch to the proprietary package first:
         pacman -S nvidia-580xx-dkms   (you appear to already have it; ensure -open is not installed)
     then reboot and re-run '$0 gsp off'."
        fi
        [[ $DRY_RUN -eq 1 ]] && { info "would write 'options nvidia NVreg_EnableGpuFirmware=0' to $GSP_CONF"; return 0; }
        printf 'options nvidia NVreg_EnableGpuFirmware=0\n' > "$GSP_CONF"
        ok "wrote $GSP_CONF — GSP will be OFF at the next nvidia load"
        if initramfs_has_nvidia; then
            warn "nvidia is in the initramfs; rebuilding so this takes effect at boot"
            command -v mkinitcpio >/dev/null 2>&1 && { [[ $DRY_RUN -eq 1 ]] || mkinitcpio -P >/dev/null 2>&1 && ok "initramfs rebuilt"; }
        fi
        info "Apply now (eGPU off, nothing holding the GPU):   $0 reload-driver"
        info "or just reboot. Confirm with:                    $0 gsp status   -> EnableGpuFirmware 0"
        info "Then activate:                                   $0 on --force-kill   (add --no-fbdev if 'drm nofbdev' is applied)"
        ;;
      on)
        need_root
        [[ $DRY_RUN -eq 1 ]] && { info "would remove $GSP_CONF"; return 0; }
        rm -f "$GSP_CONF" && ok "removed $GSP_CONF — GSP returns to default at next load"
        initramfs_has_nvidia && command -v mkinitcpio >/dev/null 2>&1 && { mkinitcpio -P >/dev/null 2>&1 && ok "initramfs rebuilt"; }
        info "Apply now:  $0 reload-driver   (or reboot)"
        ;;
      *) die "usage: $0 gsp [status|off|on]" ;;
    esac
}

# Persist what nvidia_drm / nvidia_modeset load with. One file, one module
# each; nothing else on this machine sets these options (checked modprobe.d and
# the kernel cmdline 2026-09-09), so ordering does not matter here.
drm_rebuild_initramfs() {
    initramfs_has_nvidia || return 0
    warn "nvidia is in the initramfs; rebuilding so this takes effect at boot"
    command -v mkinitcpio >/dev/null 2>&1 || { warn "mkinitcpio not found — rebuild your initramfs by hand"; return 0; }
    [[ $DRY_RUN -eq 1 ]] && return 0
    if mkinitcpio -P >/dev/null 2>&1; then ok "initramfs rebuilt"; else warn "mkinitcpio -P failed — run it by hand and read its output"; fi
}

cmd_drm() {
    local sub=${1:-status} m f
    case $sub in
      status)
        m=$(module_param nvidia_drm modeset 2>/dev/null || true)
        if [[ -z $m ]]; then
            printf '  loaded nvidia_drm:   %s\n' "$([[ $(drm_layer_mode) == not-loaded ]] && echo 'not loaded' || echo 'parameters unreadable — run as root')"
        else
            f=$(module_param nvidia_drm fbdev 2>/dev/null || true)
            printf '  loaded nvidia_drm:   modeset=%s fbdev=%s  -> %s\n' "$m" "$f" "$(drm_layer_mode)"
        fi
        if module_param nvidia_modeset disable_hdmi_frl >/dev/null 2>&1; then
            printf '  loaded nvidia_modeset: %s\n' "$(modeset_safe_loaded && echo 'HDMI-FRL / VRR disabled (safe set)' || echo 'defaults')"
        fi
        printf '  config file:         %s\n' "$([[ -f $DRM_CONF ]] && { printf '%s: ' "$DRM_CONF"; tr '\n' ';' < "$DRM_CONF"; } || echo 'none (driver defaults: modeset=1 fbdev=1)')"
        printf '  NVKMS door:          %s\n' "$(nvkms_door_sealed && echo "SEALED (/dev/null over $NVKMS_NODE; 'off' unseals)" || echo "open (sealed by 'on --no-kms' for the run)")"
        printf '  would-load:          %s\n' "$(modprobe -c 2>/dev/null | grep -E '^options nvidia_(drm|modeset) ' | tr '\n' ';')"
        printf '  nvidia in initramfs: %s\n' "$(initramfs_has_nvidia && echo 'yes (drm <mode> rebuilds it)' || echo no)"
        cat <<'EOM'
  modes:
    nokms    modeset=0           render node only; the display engine is never touched.
                                 PRIME offload still works via a system-memory path.
                                 The one to try.
    nofbdev  modeset=1 fbdev=0   KMS without the framebuffer console. Tested for real
                                 2026-09-09 19:30: died at 8.5s, identical. Ruled out
    safe     nofbdev + nvidia_modeset disable_hdmi_frl=1 disable_vrr_memclk_switch=1
                                 conceal_vrr_caps=1
    default  remove the file: modeset=1 fbdev=1, the configuration that died every run
EOM
        ;;
      nofbdev|nokms|safe)
        need_root
        local body flag
        case $sub in
          nofbdev) body='options nvidia_drm modeset=1 fbdev=0'; flag=--no-fbdev ;;
          nokms)   body='options nvidia_drm modeset=0'; flag=--no-kms ;;
          safe)    body=$'options nvidia_drm modeset=1 fbdev=0\noptions nvidia_modeset disable_hdmi_frl=1 disable_vrr_memclk_switch=1 conceal_vrr_caps=1'; flag=--modeset-safe ;;
        esac
        [[ $DRY_RUN -eq 1 ]] && { info "would write to $DRM_CONF:"; printf '    %s\n' "$body"; return 0; }
        printf '%s\n' "$body" > "$DRM_CONF"
        ok "wrote $DRM_CONF"
        drm_rebuild_initramfs
        info "Apply now (eGPU off, nothing holding the GPU):  $0 reload-driver"
        info "or reboot. Confirm with:                        $0 drm status   -> '$([[ $sub == safe ]] && echo nofbdev || echo "$sub")'"
        info "Then activate:                                  $0 on $flag --force-kill"
        ;;
      default)
        need_root
        [[ $DRY_RUN -eq 1 ]] && { info "would remove $DRM_CONF"; return 0; }
        rm -f "$DRM_CONF" && ok "removed $DRM_CONF — nvidia_drm returns to driver defaults at next load"
        drm_rebuild_initramfs
        info "Apply now:  $0 reload-driver   (or reboot)"
        ;;
      *) die "usage: $0 drm [status|nofbdev|nokms|safe|default]" ;;
    esac
}

# ---------------------------------------------------------------- PCIe generation policy
#
# The RM only allows Gen3 on platforms it recognises unless NVreg_EnablePCIeGen3=1
# (osinit.c turns that into RMPcieLinkSpeed ALLOW_GEN3). On this DIY dock the
# link trains at Gen3, the RM's allowed speed is lower, and ~10 s after init
# it retrains the link down — which this link does not survive (21:05 run:
# 8.0 -> 5.0 GT/s, Card present/Link Up, Xid 79). Telling the RM Gen3 is
# allowed removes the reason to retrain. Alternative: `on --link-gen 2`.
cmd_pcie() {
    local sub=${1:-status}
    case $sub in
      status)
        printf '  EnablePCIeGen3 (loaded): %s   (0 = RM allows Gen3 only on platforms it recognises; 1 = allowed)\n' "$(grep -oP 'EnablePCIeGen3: \K[0-9]+' "$NV_PARAMS" 2>/dev/null || echo '<nvidia not loaded>')"
        printf '  config file:             %s\n' "$([[ -f $PCIE_CONF ]] && { printf '%s: ' "$PCIE_CONF"; tr '\n' ';' < "$PCIE_CONF"; } || echo 'none (driver default)')"
        printf '  would-load:              %s\n' "$(modprobe -c 2>/dev/null | grep -E '^options nvidia .*EnablePCIeGen3' | tr '\n' ';')"
        printf '  root port %s: %s x%s\n' "$ROOT_PORT" "$(cat "$SYSFS_PCI/$ROOT_PORT/current_link_speed" 2>/dev/null)" "$(cat "$SYSFS_PCI/$ROOT_PORT/current_link_width" 2>/dev/null)"
        ;;
      gen3)
        need_root
        [[ $DRY_RUN -eq 1 ]] && { info "would write 'options nvidia NVreg_EnablePCIeGen3=1' to $PCIE_CONF"; return 0; }
        printf 'options nvidia NVreg_EnablePCIeGen3=1\n' > "$PCIE_CONF"
        ok "wrote $PCIE_CONF — the RM will treat Gen3 as allowed at the next nvidia load"
        drm_rebuild_initramfs
        info "Apply now (eGPU off):   $0 reload-driver --force-kill      (or reboot)"
        info "Confirm with:           $0 pcie status   -> EnablePCIeGen3 1"
        info "Then activate WITHOUT --link-gen (full Gen3 x8 if the link's own training holds):"
        info "                        $0 on --no-kms --force-kill"
        ;;
      default)
        need_root
        [[ $DRY_RUN -eq 1 ]] && { info "would remove $PCIE_CONF"; return 0; }
        rm -f "$PCIE_CONF" && ok "removed $PCIE_CONF — RM default at next load"
        drm_rebuild_initramfs
        info "Apply now:  $0 reload-driver --force-kill   (or reboot)"
        ;;
      *) die "usage: $0 pcie [status|gen3|default]" ;;
    esac
}

# ---------------------------------------------------------------- preconditions

need_root() {
    [[ $EUID -eq 0 ]] || die "must run as root (sysfs write + module unload)"
}

# Guard for the paths that genuinely need a root port (link speed, PM pinning).
need_root_port() {
    [[ -n $ROOT_PORT ]] || die "could not determine the PCIe root port for the XGM.
     Run 'xgm-egpu detect' to see what was found, then set ROOT_PORT in
     $CONFIG_FILE or pass --root-port BDF. See docs/PORTING.md."
}

check_interface() {
    [[ -e $ATTR_ENABLE ]] || die "$ATTR_ENABLE missing — is asus-armoury loaded? (modprobe asus-armoury)"
}

# Decode the errno the kernel's store() handler returned. The message text from
# tee/printf is generic; these are the paths that actually produce each code.
decode_errno() {
    case "$1" in
        *"No such file or directory"*|*ENOENT*)
            echo "ENOENT — kernel says EGPU_CONNECTED is 0. The board's detect line is not"
            echo "        asserted, or the EC does not believe it. Check the cable, then"
            echo "        re-read egpu_connected." ;;
        *"No such device"*|*ENODEV*)
            echo "ENODEV — the GPU MUX check failed. On a GV301QH there is no MUX, so this"
            echo "        should be unreachable; if you see it, the kernel took a path meant"
            echo "        for a different model." ;;
        *"Input/output error"*|*EIO*)
            echo "EIO   — the WMI call returned a result the driver does not accept. The"
            echo "        raw value is logged: journalctl -k | grep 'eGPU status'"
            echo "        Per osy's Software.md the AML returns 0 = Error, 1 = Success,"
            echo "        2 = Reboot required; anything but 1 or 2 becomes -EIO."
            echo ""
            echo "        'wmi result is 0x0' most often just means the eGPU is ALREADY in"
            echo "        the state you asked for, or is not attached — check egpu_enable"
            echo "        and egpu_connected before treating this as a fault. Seen"
            echo "        2026-07-31 running 'off' after a reboot had already cleared it." ;;
        *"Invalid argument"*|*EINVAL*)
            echo "EINVAL — value out of range. Valid: 0..3 (map 0x0, 0x1, 0x101, 0x201)." ;;
        *"Operation not permitted"*|*EPERM*)
            echo "EPERM — not root, or the attribute is locked by firmware." ;;
        *"Device or resource busy"*|*EBUSY*)
            echo "EBUSY — deactivation only. The WMI call reported success (0x01), but"
            echo "        the driver then re-read ASUS_WMI_DEVID_EGPU and found it still"
            echo "        non-zero, so it refused to claim the eGPU was off:"
            echo "            if (!enable) { get_devstate(...); if (result != 0) return -EBUSY; }"
            echo ""
            echo "        UNPLUG THE DOCK AND RUN 'off' AGAIN. Observed 2026-07-31:"
            echo "        'off' succeeds with egpu_connected=0 and returns EBUSY every"
            echo "        time with egpu_connected=1. The EC will not report the eGPU"
            echo "        devstate as zero while the dock is attached and powered, so"
            echo "        retrying in place cannot work — the condition never changes."
            echo "        Disabling has no egpu_connected precondition, so unplugging"
            echo "        first is always allowed." ;;
        "") : ;;
        *)  echo "unrecognised: $1" ;;
    esac
}

# ---------------------------------------------------------------- state readout

read_attr() { cat "$1" 2>/dev/null || echo "?"; }

# Tasks genuinely stuck, as opposed to merely passing through D. Threaded IRQ
# handlers (irq/33-pciehp especially, which is the hotplug line we are poking)
# and kworkers dip into D constantly as part of normal operation.
#
# Note ps 'etimes' is thread AGE, not time spent in D — kernel threads are as old
# as the boot, so an age threshold marks every one of them as wedged. The only
# honest test is to watch: sample twice and report what never left D.
wedged_tasks() {
    local candidates pid stat
    candidates=$(ps -eo pid,stat,comm --no-headers |
        awk '$2 ~ /D/ && $3 !~ /^irq\// { print $1 }')
    [[ -z $candidates ]] && return 0

    sleep "$WEDGE_SAMPLE"

    for pid in $candidates; do
        stat=$(ps -o stat= -p "$pid" 2>/dev/null) || continue
        [[ $stat == D* ]] && ps -o pid,stat,etimes,comm --no-headers -p "$pid"
    done
}

# Fallback holder scan, needing no packages at all. Walks /proc for file
# descriptors pointing at an nvidia device node. As root this is authoritative —
# it is the same information lsof reports, read from the same place.
proc_nv_holders() {
    local fd target pid comm
    for fd in /proc/[0-9]*/fd/*; do
        target=$(readlink -- "$fd" 2>/dev/null) || continue
        [[ $target == /dev/nvidia* ]] || continue
        pid=${fd#/proc/}; pid=${pid%%/*}
        comm=$(cat "/proc/$pid/comm" 2>/dev/null) || continue
        printf '%s %s\n' "$pid" "$comm"
    done | sort -u
}

nv_holders() {
    # Processes with an open handle on any /dev/nvidia* node. These are what
    # nv_pci_remove() waits on. Root-only: most holders are root daemons.
    #
    # lsof is NOT a base package on Arch or Debian — it turns up as a dependency
    # of something else, if at all. This used to call it unconditionally, so on a
    # machine without lsof it produced nothing, the caller read that as "no
    # holders", and the check that exists to prevent an unkillable D-state wedge
    # silently passed. A safety guard that fails OPEN is worse than no guard,
    # because it is trusted. Hence the fallback rather than a hard dependency.
    local out
    if command -v lsof >/dev/null 2>&1; then
        out=$(lsof -Fpc -- /dev/nvidia* 2>/dev/null | awk '
            /^p/ { pid = substr($0,2) }
            /^c/ { print pid, substr($0,2) }' | sort -u)
    else
        out=$(proc_nv_holders)
    fi
    printf '%s' "$out"
}

# Raw XGM state block from the EC. Returns "b0 b1 b2 b3" as decimal, or nothing.
ec_xgm_bytes() {
    [[ -r $EC_IO ]] || modprobe ec_sys 2>/dev/null
    [[ -r $EC_IO ]] || return 1
    dd if="$EC_IO" bs=1 skip="$EC_XGM_OFF" count=4 status=none 2>/dev/null |
        od -An -tu1 | tr -s ' ' | sed 's/^ *//;s/ *$//'
}

# Does the EC block at EC_XGM_OFF actually describe THIS machine's XGM state?
#
# EC_XGM_OFF comes from osy's annotated ACPI, which was dumped from a different
# ASUS model. EC RAM layouts are model-specific, so the offset is a hypothesis,
# not a fact. egpu_connected via WMI is known-good — if the EC byte disagrees with
# it, we are reading the wrong address and must not draw conclusions from it.
# Verified wrong on this GV301QH on 2026-07-31: WMI said connected, EC 0x1C read
# 00 00 00 00.
ec_offset_is_valid() {
    local b b1 wmi
    b=$(ec_xgm_bytes) || return 1
    [[ -n $b ]] || return 1
    read -r _ b1 _ _ <<<"$b"
    wmi=$(read_attr "$ATTR_CONNECTED")
    [[ $wmi == 0 || $wmi == 1 ]] || return 1
    [[ $(( b1 & 1 )) == "$wmi" ]]
}

# Full EC RAM, for locating the real XGM block empirically: dump with the dock
# attached, dump again detached, diff. The bytes that move are the block.
ec_dump() {
    need_root
    [[ -r $EC_IO ]] || modprobe ec_sys 2>/dev/null
    [[ -r $EC_IO ]] || die "cannot read $EC_IO"
    od -Ax -tx1 "$EC_IO"
}

# Decode per the annotated AML. Byte 0: 0x40 established / 0x80 not established.
# Byte 1: bit0 connected, bit1 lock engaged. Byte 2: bit0 AC power loss.
cmd_ec() {
    need_root
    local b; b=$(ec_xgm_bytes) || die "cannot read $EC_IO (need root; 'modprobe ec_sys')"
    [[ -n $b ]] || die "EC read returned nothing"

    local b0 b1 b2 b3; read -r b0 b1 b2 b3 <<<"$b"
    printf 'EC 0x1C raw      %02x %02x %02x %02x\n' "$b0" "$b1" "$b2" "$b3"

    case $b0 in
        64)  printf '%-16s %s\n' "link"      "0x40 established" ;;
        128) printf '%-16s %s\n' "link"      "0x80 NOT established" ;;
        *)   printf '%-16s %s\n' "link"      "$(printf '0x%02x' "$b0") — undocumented" ;;
    esac
    printf '%-16s %s\n' "connected" "$(( b1 & 1 ))"
    printf '%-16s %s\n' "lock"      "$(( (b1 >> 1) & 1 ))"
    printf '%-16s %s\n' "AC lost"   "$(( b2 & 1 ))"

    echo
    if ! ec_offset_is_valid; then
        warn "THIS DECODE IS NOT TRUSTWORTHY — ignore the lines above."
        warn ""
        warn "The connected bit here says $(( b1 & 1 )), but WMI reports egpu_connected="
        warn "$(read_attr "$ATTR_CONNECTED"). WMI is the reliable source, so offset"
        warn "$(printf '0x%02x' "$EC_XGM_OFF") is not where this machine keeps its XGM state."
        warn ""
        warn "That offset came from osy's annotated ACPI, dumped from a different ASUS"
        warn "model; EC RAM layouts are model-specific. Find the real one empirically:"
        warn ""
        warn "  $0 ec --dump > /tmp/ec-attached.txt     # dock plugged in"
        warn "  $0 ec --dump > /tmp/ec-detached.txt     # dock unplugged"
        warn "  diff /tmp/ec-attached.txt /tmp/ec-detached.txt"
        warn ""
        warn "The bytes that move between those two dumps are the XGM state block."
        return 1
    fi

    if (( (b1 >> 1) & 1 )); then
        ok "lock engaged — the AML's precondition is satisfied"
    else
        warn "LOCK NOT ENGAGED. The platform AML refuses to switch without it, and"
        warn "its _QF5/_QF6 handlers disable the eGPU whenever the lock drops. If this"
        warn "line is unstable on the DIY board, it can deassert mid-activation and"
        warn "collide with the switch already in flight."
    fi
    (( b2 & 1 )) && warn "AC POWER LOSS flagged — the AML fails the switch on this."
    return 0
}

UDEV_RULE=/etc/udev/rules.d/99-xgm-egpu-pm.rules
MODPROBE_CONF=$ETC_MODPROBE_D/nvidia.conf   # SHADOWS the distro file by name — see write_modprobe_shadow()

# Persist the power-management pinning so it survives reboots and applies the
# instant the device appears — before anything can suspend it.
#
# Boot of 2026-07-31 19:38 showed why this must be udev and not a kernel
# parameter: pcie_port_pm=off pinned the root port (suspended_ms=0) and the PCIe
# link stayed up — no pciehp Link Down at all — but the ENDPOINT was still
# control=auto, suspended into D3cold, and never came back (NVRM Xid 79, 38s in).
# The port and the card need pinning separately.
cmd_install_rules() {
    need_root

    # The vendor rule alone still covers the card, so a missing root port
    # degrades rather than fails: worth a warning, not a refusal.
    local port_rule="ACTION==\"add|bind\", SUBSYSTEM==\"pci\", KERNEL==\"$ROOT_PORT\", ATTR{power/control}=\"on\""
    if [[ -z $ROOT_PORT ]]; then
        warn "root port unknown — writing the endpoint rule only."
        warn "The card will be pinned but its bridge will not. Run 'xgm-egpu detect',"
        warn "then set ROOT_PORT in $CONFIG_FILE and re-run this."
        port_rule="# root port was not detected when this file was written; see docs/PORTING.md"
    fi

    cat > "$UDEV_RULE" <<EOF
# Installed by xgm-egpu. Keeps the XG Mobile eGPU and its root port out of
# runtime suspend: on this machine a D3cold transition never resumes, and the
# GPU drops off the bus (NVRM Xid 79) roughly 30-40s after it goes idle.
#
# Both lines matter. Pinning only the port leaves the endpoint at
# power/control=auto, which reaches D3cold on its own — and pcie_port_pm=off on
# the kernel command line does not cover the endpoint either.
ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{power/control}="on"
$port_rule
EOF
    ok "wrote $UDEV_RULE"

    # Remove the old file this tool used to write. It sorted BEFORE the distro's
    # nvidia.conf ('-' < '.') and lost, so DynamicPowerManagement=0 never took.
    rm -f "$ETC_MODPROBE_D/nvidia-xgm-egpu.conf" "$ETC_MODPROBE_D/zz-nvidia-xgm-egpu.conf"
    write_modprobe_shadow "$MODPROBE_CONF" write
    ok "wrote $MODPROBE_CONF (shadows $DISTRO_MODPROBE)"

    if initramfs_has_nvidia; then
        warn "nvidia is baked into the initramfs (MODULES= in $MKINITCPIO_CONF or $MKINITCPIO_D)."
        warn "The module loads BEFORE switch-root with whatever modprobe.d the image was"
        warn "built with, so the file above does nothing until the image is rebuilt."
        if command -v mkinitcpio >/dev/null 2>&1; then
            info "rebuilding: mkinitcpio -P"
            [[ $DRY_RUN -eq 1 ]] || mkinitcpio -P >/dev/null 2>&1 && ok "initramfs rebuilt" || warn "mkinitcpio -P failed — run it by hand"
        else
            warn "mkinitcpio not found; rebuild your initramfs by hand (dracut -f, etc.)"
        fi
        warn "REBOOT, then confirm:  grep DynamicPowerManagement $NV_PARAMS   -> 0"
    fi

    udevadm control --reload-rules 2>/dev/null && ok "udev rules reloaded"
    info "Applying to devices already present:"
    local d
    for d in "$ROOT_PORT" $(egpu_functions "$(egpu_bdf || echo)"); do
        [[ -n $d ]] && pm_pin_on "$d"
    done
    echo
    info "Remove with:  rm $UDEV_RULE $MODPROBE_CONF"
    return 0
}

cmd_status() {
    check_interface
    printf '%-18s %s\n' "egpu_connected" "$(read_attr "$ATTR_CONNECTED")  (1 = board detected by the EC)"
    printf '%-18s %s\n' "egpu_enable"    "$(read_attr "$ATTR_ENABLE")"
    printf '%-18s %s\n' "dgpu_disable"   "$(read_attr "$ATTR_DGPU")"

    printf '%-18s %s\n' "pending_reboot" "$(read_attr "$FW/pending_reboot")"

    local ac ac_online=0
    for ac in /sys/class/power_supply/*/; do
        [[ $(cat "$ac/type" 2>/dev/null) == Mains ]] || continue
        printf '%-18s %s\n' "$(basename "$ac") online" "$(cat "$ac/online" 2>/dev/null)"
        [[ $(cat "$ac/online" 2>/dev/null) == 1 ]] && ac_online=1
    done
    (( ac_online )) || warn "ON BATTERY — the AML refuses the switch without mains power"

    # The trap: EC says "use the eGPU", so the internal dGPU is switched off, but
    # no eGPU is attached to take its place. Net result is no discrete GPU at all,
    # and it persists across reboots because this lives in the EC, not in Linux.
    if [[ $(read_attr "$ATTR_ENABLE") != 0 && $(read_attr "$ATTR_CONNECTED") == 0 ]]; then
        echo
        warn "egpu_enable is on but no eGPU is connected — the internal dGPU is"
        warn "disabled with nothing replacing it. Run '$0 off' to get it back."
    fi

    echo
    info "NVIDIA devices on the bus"
    lspci -nn | grep -i nvidia || echo "  (none)"

    echo
    info "NVIDIA modules"
    lsmod | grep -E '^nvidia' || echo "  (none loaded)"

    echo
    info "Open handles on /dev/nvidia* (these block the ACPI eject)"
    local h; h=$(nv_holders)
    if [[ -n $h ]]; then
        printf '  %s\n' "$h"
    elif [[ $EUID -ne 0 ]]; then
        echo "  (none visible — but as a normal user lsof cannot see root daemons"
        echo "   such as nvidia-powerd. Re-run as root for a truthful answer.)"
    else
        echo "  (none)"
    fi

    echo
    info "Tasks in uninterruptible D state"
    local d; d=$(ps -eo pid,stat,etimes,comm --no-headers | awk '$2 ~ /D/')
    if [[ -n $d ]]; then printf '  %s\n' "$d"; else echo "  (none)"; fi
    local w; w=$(wedged_tasks)
    if [[ -n $w ]]; then
        warn "still in D after ${WEDGE_SAMPLE}s — a previous attempt is wedged:"
        printf '  %s\n' "$w" >&2
    fi
    return 0
}

# ---------------------------------------------------------------- gpu release

# Detach the nvidia driver from the internal dGPU explicitly, before anything
# touches egpu_enable.
#
# This is the difference between a bad day and a reboot. Unbinding runs
# nv_pci_remove() in *our* process context. Letting the ACPI eject trigger it
# instead runs the same code inside the kacpi_hotplug worker while it holds the
# ACPI hotplug mutex — so a stall there wedges every subsequent hotplug event and
# parks the writer in unkillable D state. Same teardown, survivable context.
unbind_internal() {
    # No internal dGPU at all (ROG Ally and similar). Nothing shares the XGM's
    # lanes, so activation triggers no eject and there is nothing to release.
    [[ -n $INTERNAL_DGPU ]] || { info "  no internal dGPU on this host — nothing to unbind"; return 0; }

    local drv=/sys/bus/pci/devices/$INTERNAL_DGPU/driver
    [[ -e $drv ]] || { info "  internal dGPU already unbound"; return 0; }

    local name; name=$(basename "$(readlink -f "$drv")")
    info "  unbinding $name from $INTERNAL_DGPU"
    [[ $DRY_RUN -eq 1 ]] && return 0

    if ! guarded_write "$INTERNAL_DGPU" "$drv/unbind"; then
        die "unbind stalled or failed. Something still holds the internal GPU.
     Nothing was written to egpu_enable, the ACPI mutex is untouched, and the
     machine is still usable — which is the whole point of unbinding first."
    fi
    ok "  internal dGPU unbound"
}

# Take the internal dGPU out of Linux's PCI tree entirely, not just unbind its
# driver.
#
# Why this and not just unbind: at step 3 the platform AML sends eject notify 0x03
# and then keeps going — step 6 reprograms the PCIe bridge via M018(), step 8
# powers the dock via FGON(). Linux's acpiphp receives that notify and starts its
# own teardown of the same slot at the same time, walking config space on a bridge
# the firmware is actively reconfiguring. Unbinding the driver does not prevent
# that; the PCI device is still there for acpiphp to act on. Removing it leaves
# acpiphp nothing to race against.
#
# Reversible without a reboot: echo 1 > /sys/bus/pci/rescan
pci_remove_internal() {
    [[ $RELEASE_LEVEL == remove ]] || return 0
    [[ -n $INTERNAL_DGPU ]] || return 0
    local dev=/sys/bus/pci/devices/$INTERNAL_DGPU
    [[ -e $dev ]] || { info "  $INTERNAL_DGPU already absent from the PCI tree"; return 0; }

    info "  removing $INTERNAL_DGPU from the PCI tree (acpiphp then has nothing to eject)"
    [[ $DRY_RUN -eq 1 ]] && return 0

    if ! guarded_write 1 "$dev/remove"; then
        die "PCI remove stalled. egpu_enable was not touched and the ACPI mutex is
     clean. Recover the device with: echo 1 > /sys/bus/pci/rescan"
    fi
    sleep 1
    [[ -e $dev ]] && warn "  $INTERNAL_DGPU still present after remove"
    return 0
}

# SIGTERM every process in the holders list ($1, nv_holders format), wait,
# SIGKILL whatever still holds /dev/nvidia*. Used by `on --force-kill` and
# `reload-driver --force-kill`.
kill_nv_holders() {
    local h=$1 pid
    while read -r pid _; do
        [[ -n $pid ]] || continue
        info "  SIGTERM $pid"
        [[ $DRY_RUN -eq 1 ]] || kill -TERM "$pid" 2>/dev/null
    done <<<"$h"
    sleep 3
    while read -r pid _; do
        [[ -n $pid ]] || continue
        kill -0 "$pid" 2>/dev/null || continue
        warn "  SIGKILL $pid"
        [[ $DRY_RUN -eq 1 ]] || kill -KILL "$pid" 2>/dev/null
    done <<<"$(nv_holders)"
    sleep 2
}

release_internal_gpu() {
    info "Releasing the internal dGPU before the ACPI eject"

    local svc
    for svc in "${NV_SERVICES[@]}"; do
        if systemctl is-active --quiet "$svc"; then
            info "  stopping $svc"
            [[ $DRY_RUN -eq 1 ]] || systemctl stop "$svc"
        fi
    done

    local h; h=$(nv_holders)
    if [[ -n $h ]]; then
        warn "still holding /dev/nvidia*:"
        printf '    %s\n' "$h" >&2
        if [[ $FORCE_KILL -eq 1 ]]; then
            kill_nv_holders "$h"
        else
            die "refusing to proceed — close these first, or re-run with --force-kill.
     Writing egpu_enable now would park this shell in D state."
        fi
    fi

    if [[ $RELEASE_LEVEL == minimal ]]; then
        ok "holders cleared; leaving the driver bound so the eject is a real one"
        info "  (the AML's SUMA/WAT1 polls for the OS to complete it — see RELEASE_LEVEL)"
        return 0
    fi

    unbind_internal

    # Unload in dependency order. Refcounts can be transiently non-zero while a
    # teardown is still in flight (nvidia_modeset held by a half-unloaded
    # nvidia_drm, say), so retry before giving up — a single-shot check reports a
    # blocker that would have cleared on its own a second later.
    local attempt m rc holders remaining
    for attempt in 1 2 3 4 5; do
        remaining=()
        for m in "${NV_MODULES[@]}"; do
            [[ -d /sys/module/$m ]] || continue
            [[ $DRY_RUN -eq 1 ]] && { remaining+=("$m"); continue; }
            rmmod "$m" 2>/dev/null || remaining+=("$m")
        done
        [[ ${#remaining[@]} -eq 0 ]] && break
        (( attempt < 5 )) && sleep 1
    done

    if [[ ${#remaining[@]} -gt 0 && $DRY_RUN -eq 0 ]]; then
        warn "modules still loaded after 5 attempts:"
        for m in "${remaining[@]}"; do
            rc=$(cat "/sys/module/$m/refcnt" 2>/dev/null || echo '?')
            holders=$(ls "/sys/module/$m/holders" 2>/dev/null | tr '\n' ' ')
            warn "    $m  refcnt=$rc  holders=[${holders:-none}]"
        done
        die "not writing egpu_enable — an unloaded-but-referenced module means the
     internal GPU is still live, which is exactly what stalls the ACPI eject."
    fi
    pci_remove_internal
    ok "internal dGPU released"
}

# Pin runtime PM to "on" so the link cannot be suspended out from under us.
#
# Observed 2026-07-31: activation succeeded completely — 3060 enumerated, BARs
# assigned, nvidia-drm initialised, HDMI audio registered, zero AER errors — and
# then ten seconds later:
#
#   pcieport 0000:00:01.1: pciehp: Slot(0): Link Down
#   pcieport 0000:00:01.1: pciehp: Slot(0): Card not present
#   NVRM: Xid 79, GPU has fallen off the bus.
#
# The root port defaults to power/control=auto with autosuspend_delay_ms=100, so
# once the freshly-bound GPU went idle the bridge dropped to D3cold and the link
# never came back. Same signature as the failed boots. Pin the bridge BEFORE the
# switch, and every eGPU function after it appears.
# Push ASPM to "performance", which disables the L0s/L1 low-power link states.
#
# The link on this machine cannot change speed (see cmd_link_speed). It idles down
# to Gen1 and then cannot climb back. Keeping ASPM out of the picture is the
# cheapest way to stop it descending in the first place, so no retrain is needed.
# Runtime-writable, and reverts on reboot.
aspm_performance() {
    local p=/sys/module/pcie_aspm/parameters/policy
    [[ -w $p ]] || { info "  ASPM policy not writable — skipping"; return 0; }
    local cur; cur=$(sed -n 's/.*\[\([a-z]*\)\].*/\1/p' "$p" 2>/dev/null)
    [[ $cur == performance ]] && { info "  ASPM policy already 'performance'"; return 0; }
    if echo performance > "$p" 2>/dev/null; then
        ok "  ASPM policy: $cur -> performance"
    else
        warn "  could not set ASPM policy (was '$cur')"
    fi
}

# ---------------------------------------------------------------- the audio function
#
# The 3060 is two PCI functions: 01:00.0 (GPU) and 01:00.1 (HDMI audio). With
# autoprobe on, snd_hda_intel binds .1 the instant it enumerates and starts
# probing the HDA codec inside the GPU. Journals of the four deaths of
# 2026-09-09 (15:17, 19:30, 20:52 and the fbdev run) end identically:
#
#   pciehp: Slot(0): Link Down
#   snd_hda_codec_nvhdmi hdaudioC2D0: HDMI: invalid ELD buf size -1   (x17)
#   snd_hda_intel 0000:01:00.1: GPU sound probed, but not operational
#
# and the GSP RPC in flight is always NV0073_CTRL_CMD_DFP_SET_ELD_AUDIO_CAPS —
# the RM servicing that codec. Both survivors (unbound; `bind core` with
# autoprobe off) had no driver on .1, and the internal 1650 has no .1 at all.
# power_save is 0 here, so it is not the codec suspend timer; it is the codec
# being alive. So: enumerate with autoprobe off, fence .1 with a
# driver_override no driver can match, bind nvidia to .0 by hand, restore.
# A udev rule cannot do this: the kernel binds during the rescan, before udev.
fence_audio_function() {
    local gpu=$1 aud=${1%.*}.1
    [[ -e $SYSFS_PCI/$aud ]] || { info "  no audio function at $aud — nothing to fence"; return 0; }
    if [[ $DRY_RUN -eq 1 ]]; then info "  would write xgm-egpu-noaudio > $SYSFS_PCI/$aud/driver_override"; return 0; fi
    if echo xgm-egpu-noaudio > "$SYSFS_PCI/$aud/driver_override" 2>/dev/null; then
        ok "  HDMI audio function $aud fenced off: no driver will bind to it (--audio to allow)"
    else
        warn "  could not set driver_override on $aud"; return 1
    fi
    # readlink -f canonicalises a MISSING symlink to its own path, so a bare
    # basename of it reads "driver" and looked like a bound driver on the
    # 21:05 run (false alarm: the kernel log shows no bind). Test existence.
    if [[ -e $SYSFS_PCI/$aud/driver ]]; then
        local drv; drv=$(basename "$(readlink -f "$SYSFS_PCI/$aud/driver")")
        warn "  $aud is ALREADY bound to $drv — unbinding it"
        [[ $DRY_RUN -eq 1 ]] || echo "$aud" > "/sys/bus/pci/drivers/$drv/unbind" 2>/dev/null && ok "  $drv unbound from $aud" || warn "  could not unbind $drv from $aud"
    else
        info "  $aud has no driver (autoprobe was off in time)"
    fi
    return 0
}
bind_gpu_by_hand() {
    local gpu=$1
    [[ $DRY_RUN -eq 1 ]] && { info "  would: modprobe nvidia; echo $gpu > /sys/bus/pci/drivers/nvidia/bind"; return 0; }
    modprobe nvidia 2>/dev/null || true
    if [[ -e $SYSFS_PCI/$gpu/driver ]]; then
        info "  nvidia already bound to $gpu"
    elif echo "$gpu" > /sys/bus/pci/drivers/nvidia/bind 2>/dev/null; then
        ok "  nvidia bound to $gpu by hand (audio function left alone)"
    else
        warn "  manual bind of nvidia to $gpu failed"; return 1
    fi
}

pm_pin_on() {
    local d p
    for d in "$@"; do
        p=/sys/bus/pci/devices/$d/power/control
        [[ -w $p ]] || continue
        [[ $(cat "$p" 2>/dev/null) == on ]] && continue
        if echo on > "$p" 2>/dev/null; then
            info "  runtime PM pinned on for $d"
        else
            warn "  could not pin runtime PM for $d"
        fi
    done
}

# Every PCI function of the eGPU (the GPU plus its HDMI audio sibling).
egpu_functions() {
    local bdf=${1:-}
    [[ -n $bdf ]] || return 0
    local base=${bdf%.*}
    local f
    for f in /sys/bus/pci/devices/"$base".*; do
        [[ -e $f ]] && basename "$f"
    done
}

reload_nvidia() {
    # Binding the driver is a prime suspect in its own right: on Windows, deep
    # interrogation of this card by GPU-Z bugchecks with a surprise-removal
    # subcode while FurMark runs fine. Being able to stop *before* the bind
    # separates "enumeration killed it" from "the NVIDIA driver killed it".
    if [[ $RELOAD_NVIDIA -eq 0 ]]; then
        info "Skipping the NVIDIA reload (--no-reload)"
        info "  the eGPU is enumerated but unbound. If the machine is still alive"
        info "  now, enumeration is safe and the driver bind is the killer."
        info "  Bind manually when ready with:  modprobe nvidia"
        return 0
    fi
    info "Reloading the NVIDIA stack"
    [[ $DRY_RUN -eq 1 ]] && return 0
    # This used to pass NVreg_DynamicPowerManagement=0 here. That is a no-op:
    # modprobe of an already-resident module ignores parameters, and with
    # --release minimal the module is never unloaded. The value has to be right
    # at BOOT (modprobe shadow + initramfs), which preflight_rtd3 verifies.
    modprobe nvidia || warn "modprobe nvidia failed"
    if [[ $CAP_POWER -eq 1 ]]; then
        # The core is bound now (autoprobe). Clamp BEFORE the display engine.
        local cb; cb=$(egpu_bdf || echo "")
        [[ -n $cb ]] && cap_gpu_power "$cb"
    fi
    # No parameters are passed here any more. With --release minimal these
    # modules are resident, modprobe against a resident module is a no-op, and
    # nvidia_drm attaches to the eGPU by itself (KAPI probe callback) with the
    # values it was loaded with. `drm <mode>` sets them; preflight_drm_layer
    # verified them before the write. See the DRM-layer section.
    modprobe nvidia_modeset  || true
    modprobe nvidia_uvm      || true
    [[ $NO_DRM_POLL -eq 1 ]] && drm_poll_disable
    modprobe nvidia_drm      || true
    info "  DRM layer in effect on the eGPU: $(drm_layer_mode)"
    # Deliberately NOT restarting nvidia-powerd. It manages Dynamic Boost on the
    # internal dGPU, which is switched off in eGPU mode, and it is the daemon
    # whose 15 open fds stalled the very first activation for 856 seconds.
}

# ---------------------------------------------------------------- guarded write

# Write to sysfs without ever blocking the caller. The write runs in a background
# subshell; we poll it against a deadline. A D-state task cannot be killed, so on
# timeout we report and bail rather than pretending we can clean up.
guarded_write() {
    local value=$1 path=$2
    local errfile; errfile=$(mktemp)

    ( printf '%s' "$value" > "$path" ) 2>"$errfile" &
    local wpid=$!

    local waited=0 nudged=0
    while kill -0 "$wpid" 2>/dev/null; do
        if (( waited >= PATIENCE && nudged == 0 )); then
            nudged=1
            info "  still working after ${PATIENCE}s — this is normal, it drives a full"
            info "  ACPI eject and PCI rescan. Waiting up to ${TIMEOUT}s before giving up."
        fi
        if (( waited >= TIMEOUT )); then
            local st; st=$(awk '{print $3}' "/proc/$wpid/stat" 2>/dev/null || echo '?')
            warn "write to $(basename "$(dirname "$path")") did not return after ${TIMEOUT}s (state=$st)"
            if [[ $st == D* ]]; then
                warn "task $wpid is in uninterruptible sleep — the teardown is stalled."
                warn "kernel stack:"
                sed 's/^/      /' "/proc/$wpid/stack" 2>/dev/null >&2 || warn "      (unreadable)"
                warn ""
                warn "A holder of the internal GPU survived the release step; PID $wpid is"
                warn "now unkillable. If the stack shows acpiphp_disable_and_eject_slot the"
                warn "ACPI hotplug mutex is held and the machine needs 'systemctl reboot'"
                warn "(escalate to 'systemctl reboot -ff'). If it shows only nv_pci_remove"
                warn "from a driver unbind, releasing the holder may still let it complete."
            fi
            rm -f "$errfile"
            return 124
        fi
        # One second per tick. This used to sleep 0.5 and increment by 1, so every
        # threshold fired at half its stated value — PATIENCE=20 announced itself
        # at 10s and TIMEOUT=180 would have given up at 90s. Caught by comparing
        # journal timestamps against the numbers the script printed.
        sleep 1
        waited=$(( waited + 1 ))
    done

    wait "$wpid"; local rc=$?
    local err; err=$(<"$errfile"); rm -f "$errfile"

    if (( rc != 0 )); then
        warn "write failed (rc=$rc)"
        [[ -n $err ]] && warn "  $err"
        decode_errno "$err" | sed 's/^/      /' >&2
        return "$rc"
    fi
    return 0
}

# ---------------------------------------------------------------- link status

egpu_bdf() {
    # The first NVIDIA display-class function that is not the internal TU117M.
    # Matching on device ID rather than address, because the eGPU can legitimately
    # enumerate at 0000:01:00.0 — the slot the internal dGPU just vacated. Audio
    # functions (class 0403) are skipped so we return the GPU, not its HDMI codec.
    local d ven dev cls
    for d in /sys/bus/pci/devices/*/; do
        ven=$(cat "$d/vendor" 2>/dev/null) || continue
        [[ $ven == 0x10de ]] || continue
        dev=$(cat "$d/device" 2>/dev/null)
        [[ $dev == "$INTERNAL_DEVID" ]] && continue
        cls=$(cat "$d/class" 2>/dev/null)
        [[ $cls == 0x0300* || $cls == 0x0302* ]] || continue
        basename "$d"
        return 0
    done
    return 1
}

# Pin the link to a fixed PCIe generation on the root port.
#
# Why: on 2026-07-31 the link proved stable at a steady speed but unable to CHANGE
# speed. It idles at Gen1 (NVIDIA downtrains at P8); when load arrives it tries to
# climb to Gen3, reaches Gen2, and stalls:
#
#   pciehp: Slot(0): Cannot train link: status 0x3882
#     bits 3:0 = 2      -> current speed Gen2
#     bits 9:4 = 8      -> width x8
#     bit 11   = 1      -> link training in progress
#
# followed by Xid 79. Same mechanism as the Windows GPU-Z bugcheck, which forces a
# retrain, while FurMark at an already-established Gen3 runs fine.
#
# Target Link Speed lives in Link Control 2, bits 3:0, at CAP_EXP+0x30. Setting it
# does not retrain by itself — bit 5 (0x20) of Link Control at CAP_EXP+0x10 is the
# Retrain Link bit. Reverts on reboot; nothing here is persistent.
set_target_link_speed() {
    local gen=$1 retrain=${2:-1}
    need_root_port
    command -v setpci >/dev/null 2>&1 || { warn "setpci not installed (pciutils)"; return 1; }

    local lnkctl2 cur new
    lnkctl2=$(setpci -s "$ROOT_PORT" CAP_EXP+30.w 2>/dev/null) ||
        { warn "could not read Link Control 2 on $ROOT_PORT"; return 1; }
    cur=$(( 0x$lnkctl2 & 0xF ))

    if (( cur == gen )); then
        info "  $ROOT_PORT already targeting Gen$gen"
    else
        new=$(printf '%04x' $(( (0x$lnkctl2 & 0xFFF0) | gen )))
        info "  $ROOT_PORT target link speed Gen$cur -> Gen$gen (0x$lnkctl2 -> 0x$new)"
        setpci -s "$ROOT_PORT" CAP_EXP+30.w="$new" ||
            { warn "write to Link Control 2 failed"; return 1; }
    fi

    (( retrain )) || return 0
    # A retrain is the operation this link fails at (2026-09-09 21:05: the
    # speed changed 8.0 -> 5.0 GT/s under the driver and the card fell off the
    # bus). Never retrain a link that is already running at the target speed.
    local live; live=$(cat "$SYSFS_PCI/$ROOT_PORT/current_link_speed" 2>/dev/null | grep -oE '^[0-9.]+')
    local want; case $gen in 1) want=2.5 ;; 2) want=5.0 ;; 3) want=8.0 ;; 4) want=16.0 ;; *) want= ;; esac
    if (( cur == gen )) && [[ -n $live && $live == "$want" ]]; then
        info "  link already running at ${live} GT/s — not retraining"
        return 0
    fi
    local lnkctl
    lnkctl=$(setpci -s "$ROOT_PORT" CAP_EXP+10.w 2>/dev/null) || return 0
    setpci -s "$ROOT_PORT" CAP_EXP+10.w="$(printf '%04x' $(( 0x$lnkctl | 0x20 )))" ||
        warn "  retrain write failed"
    sleep 2
    return 0
}

cmd_link_speed() {
    need_root
    local gen=${1:-}
    case "$gen" in
        1|2|3|4) ;;
        *) die "usage: $0 link-speed <1|2|3|4>   (target PCIe generation)" ;;
    esac
    info "Pinning $ROOT_PORT target link speed to Gen$gen"
    set_target_link_speed "$gen" 1 || die "could not set the target link speed"
    echo
    cmd_link
}

cmd_link() {
    local bdf=${1:-$(egpu_bdf)}
    [[ -n $bdf ]] || die "no external NVIDIA device found on the bus"
    local d=/sys/bus/pci/devices/$bdf

    # sysfs, not `lspci -vv` — the latter needs root for the capability block and
    # silently prints nothing without it, which previously read as "no link".
    info "PCIe link for $bdf"
    printf '  %-22s %s x%s\n' "current" "$(cat "$d/current_link_speed" 2>/dev/null)" "$(cat "$d/current_link_width" 2>/dev/null)"
    printf '  %-22s %s x%s\n' "device capability" "$(cat "$d/max_link_speed" 2>/dev/null)" "$(cat "$d/max_link_width" 2>/dev/null)"

    # nvidia-smi reports the NEGOTIATED ceiling for this link, which is the number
    # that matters. sysfs max_link_speed is the card's own capability (16 GT/s
    # x16 on a 3060) and says nothing about what the XGM path can carry.
    local gen_cur='' gen_max='' width='' pstate=''
    if command -v nvidia-smi >/dev/null 2>&1; then
        local q
        q=$(nvidia-smi --query-gpu=pstate,pcie.link.gen.current,pcie.link.gen.max,pcie.link.width.current \
            --format=csv,noheader,nounits 2>/dev/null | head -1)
        # nvidia-smi writes "No devices were found" to STDOUT, not stderr, so a
        # non-empty $q is NOT proof of a valid reading. Without the numeric check
        # that error text gets split into the fields and printed as
        # "Gen x / perf state Nodeviceswerefound".
        IFS=',' read -r pstate gen_cur gen_max width <<<"$q"
        pstate=${pstate// /}; gen_cur=${gen_cur// /}; gen_max=${gen_max// /}; width=${width// /}
        if [[ $gen_max =~ ^[0-9]+$ && $gen_cur =~ ^[0-9]+$ && $width =~ ^[0-9]+$ ]]; then
            printf '  %-22s Gen%s x%s\n' "negotiated ceiling" "$gen_max" "$width"
            printf '  %-22s Gen%s  (perf state %s)\n' "running at" "$gen_cur" "$pstate"
        else
            gen_cur=''; gen_max=''; width=''; pstate=''
            printf '  %-22s %s\n' "nvidia-smi" "no usable reading — driver not bound, or GPU is off the bus"
        fi
    fi

    # The root port's Target Link Speed is the real cap — it is what --link-gen
    # sets, and it is NOT nvidia-smi's pcie.link.gen.max, which reports the
    # device's own capability and stays at 3 even when the port is pinned to 1.
    # Confusing the two makes a pinned, safe link look like it is about to ramp.
    local tls=''
    if command -v setpci >/dev/null 2>&1; then
        local l2; l2=$(setpci -s "$ROOT_PORT" CAP_EXP+30.w 2>/dev/null)
        if [[ $l2 =~ ^[0-9a-fA-F]+$ ]]; then
            tls=$(( 0x$l2 & 0xF ))
            printf '  %-22s Gen%s  (root port cap, what --link-gen sets)\n' "target link speed" "$tls"
        fi
    else
        printf '  %-22s %s\n' "target link speed" "unknown — needs root (setpci)"
    fi

    echo
    if [[ $tls == 1 ]]; then
        ok "Pinned to Gen 1. On this machine that is the ONLY speed the link has"
        ok "sustained: it stalls mid-training at Gen 2 and dies within seconds at"
        ok "Gen 3. ~2 GB/s, but it stays up. It should NOT ramp under load — if"
        ok "you see the current speed rise above Gen 1, the pin has been lost."
    elif [[ -n $tls ]] && (( tls > 1 )); then
        # Retired 2026-09-09: an UNBOUND card holds Gen3 x8 indefinitely with
        # zero AER errors, so the link is not the problem and --link-gen 1 is
        # not a fix. Kept as an informational line only.
        info "Target link speed is Gen$tls (root port cap). Unbound, this link holds Gen3 x8."
    else
        case "$gen_max" in
            3) info "Device reports a Gen 3 x$width capability (this is NOT the port cap)." ;;
            *) warn "could not read the negotiated ceiling (is the driver bound?)" ;;
        esac
    fi

    if [[ -n $gen_cur && -n $tls ]] && (( gen_cur > tls )); then
        warn "Running at Gen$gen_cur, above the Gen$tls cap — the pin is not holding."
    fi

    echo
    info "AER error counters (non-zero here is the real marginal-link signal)"
    local f nz
    for f in aer_dev_correctable aer_dev_nonfatal aer_dev_fatal; do
        [[ -r $d/$f ]] || continue
        nz=$(grep -v ' 0$' "$d/$f" 2>/dev/null | tr '\n' ' ')
        printf '  %-22s %s\n' "$f" "${nz:-all zero}"
    done
}

# ---------------------------------------------------------------- commands

cmd_on() {
    need_root; check_interface

    [[ $(read_attr "$ATTR_CONNECTED") == 1 ]] || die "egpu_connected is not 1 — the EC does not see the board. Not writing."
    if [[ $(read_attr "$ATTR_ENABLE") == 1 ]]; then
        ok "egpu_enable is already 1"
        # After a death the EC still says 1 while the card is gone from the bus
        # (config space reads all-ones: 'current_link_speed' empty, capability
        # "16.0 GT/s x255"). On 2026-09-09 21:19 that produced a retrain warning
        # about a link that did not exist. Say what is actually going on.
        local ebdf; ebdf=$(egpu_bdf || true)
        if [[ -z $ebdf ]] || ! device_alive "$ebdf" || [[ -z $(cat "$SYSFS_PCI/$ebdf/current_link_speed" 2>/dev/null) ]]; then
            die "...but the eGPU is NOT alive on the bus: the EC state is left over from a run
     that died. Recover first, then re-run this exact command:
         1. unplug the dock
         2. $0 off                       (restores the internal dGPU)
         3. $0 reload-driver --force-kill  (clean driver state; if it cannot
            unload, reboot — the dead GPU can pin a refcount)
         4. plug the dock back in and lock it"
        fi
        # Honour --link-gen even here: asking for a generation on an already-active
        # eGPU is a clear request to change it, and silently dropping the flag
        # leaves the caller believing a pin was applied when it was not.
        if [[ -n $LINK_GEN ]]; then
            local now
            now=$(setpci -s "$ROOT_PORT" CAP_EXP+30.w 2>/dev/null)
            now=$(( 0x${now:-0} & 0xF ))
            if (( now != LINK_GEN )); then
                warn "--link-gen $LINK_GEN would RETRAIN a link that is currently up at Gen$now."
                warn "Changing speed is the exact operation this link fails at. If it goes"
                warn "wrong you lose the working eGPU and need the full recovery cycle."
                warn "To do it anyway, deliberately:  $0 link-speed $LINK_GEN"
            else
                info "already pinned to Gen$LINK_GEN"
            fi
        fi
        cmd_link
        return 0
    fi

    # AC is a hard precondition in the AML (step 2 fails on "AC power loss", and
    # 0xBB is a dedicated External Power Loss event). Unlike EC RAM, the standard
    # power_supply sysfs works fine here, so there is no excuse for not checking.
    # Powering up a desktop 3060 on battery is a bad idea independently.
    local ac_online=0 ac
    for ac in /sys/class/power_supply/*/; do
        [[ $(cat "$ac/type" 2>/dev/null) == Mains ]] || continue
        [[ $(cat "$ac/online" 2>/dev/null) == 1 ]] && ac_online=1
    done
    (( ac_online )) || die "the laptop is on BATTERY — no mains adapter online.
     The platform AML refuses the switch on AC power loss (it is the same
     condition behind the 0xBB External Power Loss event), and spinning up the
     eGPU unplugged is a bad idea regardless. Plug in the charger and retry."

    # Check the AML's own preconditions before handing it the request. It reads
    # EC 0x1C and fails on AC loss or an unengaged lock; asking anyway just means
    # discovering that the hard way. Advisory if the EC is unreadable.
    # Only enforce this if the EC offset has been corroborated against WMI. An
    # unverified offset reads zeros and would block activation forever on a
    # phantom "lock disengaged" — which is exactly what it did on first use.
    local ecb
    if ec_offset_is_valid && ecb=$(ec_xgm_bytes); then
        local e0 e1 e2; read -r e0 e1 e2 _ <<<"$ecb"
        info "EC $(printf '0x%02x' "$EC_XGM_OFF"): $(printf '%02x %02x %02x' "$e0" "$e1" "$e2")  (connected=$(( e1 & 1 )) lock=$(( (e1 >> 1) & 1 )) ac_lost=$(( e2 & 1 )))"
        (( e2 & 1 )) && die "EC reports AC power loss. The platform AML fails the switch on this."
        (( (e1 >> 1) & 1 )) || die "EC reports the connector lock is NOT engaged.
     The platform AML requires it, and its _QF5/_QF6 handlers disable the eGPU
     whenever the lock drops — including partway through a switch."
    else
        info "skipping the EC lock/AC precheck — offset $(printf '0x%02x' "$EC_XGM_OFF") is unverified on"
        info "this model (see '$0 ec'). The AML performs these checks itself regardless."
    fi

    local d; d=$(wedged_tasks)
    [[ -n $d ]] && die "a task stayed in D state across ${WEDGE_SAMPLE}s of sampling — a previous
     attempt is wedged and only a reboot clears it:
$(printf '     %s\n' "$d")"

    # The check that would have saved 2026-09-09. Refuse while the loaded driver
    # has RTD3 armed, unless explicitly reproducing the failure.
    # Skip when --no-reload: the driver never binds, so RTD3 cannot act on the
    # card and gating on it would block the one test that isolates the driver.
    if [[ $RELOAD_NVIDIA -eq 1 ]] && ! preflight_rtd3; then
        [[ $IGNORE_RTD3 -eq 1 ]] && warn "--ignore-rtd3: proceeding anyway" || die "not activating with RTD3 armed"
    fi

    # The DRM layer is decided by what is LOADED, not by this run's options:
    # nvidia_drm attaches to the eGPU itself, with the parameters it booted with.
    if [[ $RELOAD_NVIDIA -eq 1 ]] && ! preflight_drm_layer; then
        die "not activating with the wrong DRM layer loaded (see above)"
    fi

    # With modeset=0 there is no KMS node to grab, so this only applies to the
    # KMS paths (full / nofbdev / safe).
    local live
    if [[ $RELOAD_NVIDIA -eq 1 && $NO_KMS -eq 0 ]] && live=$(desktop_is_live); then
        warn "A graphical session is running ($live). It opens the eGPU's KMS node the"
        warn "moment it appears; if the card dies, the whole desktop freezes into garbage,"
        warn "you power-cycle, and the crash dump is lost (2026-09-09 19:30, again)."
        warn "Safer: Ctrl+Alt+F3, log in, 'sudo systemctl stop sddm', then run this there."
        warn "(Not needed for --no-kms: a render-only node is invisible to compositors.)"
        warn "Continuing in 8s — Ctrl+C to stop."
        sleep 8
    fi

    release_internal_gpu

    # --no-reload must mean "the driver does not touch the card". Skipping our
    # own modprobe is not enough: the resident module auto-binds on enumeration.
    if [[ $RELOAD_NVIDIA -eq 0 ]]; then
        info "Disabling PCI driver autoprobe so the eGPU enumerates UNBOUND"
        autoprobe_disable && trap autoprobe_restore EXIT
    elif [[ $NO_AUDIO -eq 1 ]]; then
        info "Disabling PCI driver autoprobe so snd_hda_intel cannot grab the audio function (--audio to allow)"
        autoprobe_disable && trap autoprobe_restore EXIT
    fi

    # Every activation is a potential hang, and every hang so far that was not
    # armed left nothing on disk. So arm the capture here, unconditionally,
    # instead of relying on a separate command being remembered (2026-09-09).
    if [[ $AUTO_CAPTURE -eq 1 ]]; then
        info "Arming hang capture (automatic; --no-capture to skip)"
        capture_arm || warn "  capture partially armed — see above"
        capture_netconsole || true
    fi

    if [[ $NO_KMS -eq 1 && $SEAL_NVKMS -eq 1 && $RELOAD_NVIDIA -eq 1 ]]; then
        info "Sealing the NVKMS door before the eGPU appears (--no-seal to skip)"
        seal_nvkms_door || die "could not seal $NVKMS_NODE — a client could bring the display engine up. --no-seal to proceed anyway."
    fi

    info "Writing 1 to egpu_enable (timeout ${TIMEOUT}s)"
    [[ $DRY_RUN -eq 1 ]] && { ok "dry run — stopping before the write"; return 0; }

    # Pin the bridge before the switch. It survives the eject, and if it ever
    # autosuspends the link drops and the eGPU is gone.
    pm_pin_on "$ROOT_PORT"
    [[ $ASPM_PERF -eq 1 ]] && aspm_performance
    [[ -n $LINK_GEN ]] && set_target_link_speed "$LINK_GEN"

    # Flush the journal before the write. Everything after this point can take the
    # machine down, and an unflushed buffer is the one thing that would leave us
    # with no record of how far it got.
    command -v journalctl >/dev/null 2>&1 && journalctl --flush 2>/dev/null
    sync
    # Capture the status directly. Inside `if ! cmd; then`, $? is the status of the
    # negation — always 0 — so reading it there silently loses the 124 and skips
    # the warning below, which is the most important thing this script ever prints.
    guarded_write 1 "$ATTR_ENABLE"
    local wrc=$?
    if (( wrc != 0 )); then
        if (( wrc == 124 )); then
            warn ""
            warn "READ THIS BEFORE REBOOTING."
            warn ""
            warn "A timeout does NOT mean the write was rejected. In the kernel the WMI"
            warn "call (armoury_set_devstate) runs FIRST and commits to the EC; only then"
            warn "does armoury_pci_rescan() take pci_rescan_remove_lock — which is where"
            warn "this stalls, because the ACPI eject that same WMI call triggered is"
            warn "already holding it. So the EC has very likely accepted the change even"
            warn "though the write never returned and current_value still reads 0."
            warn ""
            warn "egpu_enable is PERSISTENT EC STATE. It survives a reboot, and a"
            warn "forced power-off. On the next boot the internal dGPU will be disabled."
            warn "If the eGPU is attached and its link does not train, the machine may"
            warn "fail to boot at all."
            warn ""
            warn "Recover by DISCONNECTING the eGPU, booting, and running:  $0 off"
            warn "('off' works with the eGPU unplugged: the egpu_connected guard in the"
            warn "kernel applies only to enabling, not to disabling.)"
        fi
        return "$wrc"
    fi

    ok "write returned; the kernel performs its own PCI rescan (armoury_pci_rescan)"

    info "Waiting up to ${SETTLE}s for the eGPU to enumerate"
    local i bdf=
    for ((i=0; i<SETTLE; i++)); do
        bdf=$(egpu_bdf); [[ -n $bdf ]] && break
        sleep 1
    done

    if [[ -z $bdf ]]; then
        warn "no external NVIDIA device appeared after ${SETTLE}s"
        warn "egpu_enable now reads: $(read_attr "$ATTR_ENABLE")"
        warn "check: dmesg | grep -iE 'pci|asus|egpu' | tail -40"
        return 1
    fi
    ok "eGPU enumerated at $bdf"

    # Re-pin the speed BEFORE anything binds: the AML reconfigures the bridge
    # at its step 6 (M018()), which can undo the pre-switch pin, and a retrain
    # on an unbound card is survivable where one under the driver is not.
    [[ -n $LINK_GEN ]] && set_target_link_speed "$LINK_GEN"
    info "  link now: $(cat "$SYSFS_PCI/$bdf/current_link_speed" 2>/dev/null) x$(cat "$SYSFS_PCI/$bdf/current_link_width" 2>/dev/null)"

    if [[ $NO_AUDIO -eq 1 && $RELOAD_NVIDIA -eq 1 ]]; then
        fence_audio_function "$bdf"
        bind_gpu_by_hand "$bdf"
        autoprobe_restore
    fi

    # Pin every function of the eGPU (GPU + HDMI audio) before binding a driver,
    # so nothing can suspend the link once the GPU goes idle.
    # shellcheck disable=SC2046
    pm_pin_on $(egpu_functions "$bdf") "$ROOT_PORT"

    reload_nvidia
    sleep 2

    # What actually matters after the bind: is RTD3 armed on THIS GPU?
    if [[ $RELOAD_NVIDIA -eq 1 ]]; then
        local rtd3; rtd3=$(nvidia_gpu_power_status "$bdf")
        local dpm;  dpm=$(nvidia_dpm_value)
        printf '\n'; info "RTD3 on $bdf: ${rtd3:-unknown}   (module DynamicPowerManagement=${dpm:-?})"
        if [[ $rtd3 == Enabled* || ( -n $dpm && $dpm != 0 ) ]]; then
            warn "RTD3 is ARMED on the eGPU. Expect Link Down in ~10s. See: $0 preflight"
        fi

        :
    fi

    # THE measurement, and it must run in BOTH modes: with --no-reload it is the
    # whole point (does an UNBOUND card survive?), and RTD3 was proven not to be
    # the cause on 2026-09-09, so this is still an open failure either way.
    if true; then
        if (( SURVIVAL_SECS > 0 )); then
            [[ $MASK_PCIEHP -eq 1 ]] && { pciehp_mask && trap 'pciehp_restore; autoprobe_restore' EXIT; }
            info "Watching the link for ${SURVIVAL_SECS}s (the old failure was at 10s)..."
            # Breadcrumb: the machine has hard-hung at the death with NO journal
            # record (2026-09-09 14:48, boot hard-cut, F2FS recovery on next
            # boot). Write+fsync last-known-state every second so a silent hang
            # still leaves the final samples on disk.
            local crumb=/var/tmp/xgm-last-run.txt
            { echo "run $(date -Is) bdf=$bdf opts: cap=$CAP_POWER drm=$(drm_layer_mode) audio=$((1-NO_AUDIO)) maskhp=$MASK_PCIEHP msafe=$MODESET_SAFE"; } > "$crumb"; sync
            local t alive=1 prev='' cur lnk prev_lnk='' speed_changed=0
            for ((t=1; t<=SURVIVAL_SECS; t++)); do
                sleep 1
                device_alive "$bdf" || { alive=0; break; }
                cur=$(smi_line)
                lnk=$(cat "$SYSFS_PCI/$bdf/current_link_speed" 2>/dev/null | tr -d ' ')
                printf '%ss %s link=%s\n' "$t" "${cur:-<no smi>}" "$lnk" >> "$crumb"; sync
                if [[ -n $prev_lnk && $lnk != "$prev_lnk" ]]; then
                    warn "  ${t}s: LINK SPEED CHANGED $prev_lnk -> $lnk under the driver — a retrain. This is the killer (see --link-gen)."
                    speed_changed=1
                fi
                prev_lnk=$lnk
                if [[ -n $cur && $cur != "$prev" ]]; then
                    info "  ${t}s: pstate,sm,mem,W,gen,C = $cur"; prev=$cur
                elif (( t % 5 == 0 )); then
                    info "  ${t}s: still up"
                fi
            done
            echo "end t=${t} alive=${alive}" >> "$crumb"; sync
            if (( alive )); then
                ok "LINK SURVIVED ${SURVIVAL_SECS}s past driver init."
                save_kernel_log 150
            else
                warn "link DIED at ~${t}s. dmesg tail:"
                dmesg 2>/dev/null | grep -iE 'Link Down|Xid|nvrm' | tail -5 | sed 's/^/    /' >&2
                save_kernel_log 600
                collect_gpu_crash_dump || true
                death_recovery_hint
                warn ""
                warn "What every death has in common (2026-09-09 21:05, link sampled each second):"
                warn "the link CHANGED SPEED under the driver — 8.0 -> 5.0 GT/s — and the card fell"
                warn "off the bus in the retrain. Unbound it holds Gen3 x8 forever; the NVIDIA"
                warn "driver's dynamic PCIe generation switching asks for the retrain ~10 s in,"
                warn "and this link cannot survive one at/through Gen3 (8 GT/s needs equalization)."
                [[ $speed_changed -eq 1 ]] && warn "This run's watch saw that speed change happen."
                warn "Next: cap the link at Gen2 (no equalization; 4 GB/s = Thunderbolt-eGPU class):"
                warn "    $0 on --no-kms --link-gen 2 --force-kill"
                die "the eGPU fell off the bus at ~${t}s."
            fi
        fi
    fi
    echo; cmd_link "$bdf"
    echo; info "nvidia-smi"; nvidia-smi 2>&1 | head -15
}

cmd_off() {
    need_root; check_interface
    unseal_nvkms_door

    # Short-circuit when already off. Without this the AML is asked to disable
    # something that is not enabled, returns result 0x0 ("Error"), and the driver
    # turns that into -EIO — which reads like a fault when nothing is wrong.
    if [[ $(read_attr "$ATTR_ENABLE") == 0 ]]; then
        ok "egpu_enable is already 0 — nothing to do"
        [[ $(read_attr "$FW/pending_reboot") == 1 ]] &&
            info "pending_reboot is set; reboot to settle the last change"
        return 0
    fi

    release_internal_gpu
    info "Writing 0 to egpu_enable (timeout ${TIMEOUT}s)"
    [[ $DRY_RUN -eq 1 ]] && { ok "dry run — stopping before the write"; return 0; }
    command -v journalctl >/dev/null 2>&1 && journalctl --flush 2>/dev/null
    sync

    guarded_write 0 "$ATTR_ENABLE"
    local wrc=$?
    if (( wrc == 124 )); then
        # This exact case burned us on 2026-07-31: 'off' hit the timeout, looked
        # like a failed recovery, and had in fact completed. Do not let the next
        # person conclude the machine is unrecoverable.
        warn ""
        warn "Do not panic, and do not power-cycle yet."
        warn ""
        warn "A timeout on 'off' does not mean the disable failed. This has been"
        warn "observed completing successfully on its own shortly afterwards. The"
        warn "EC commit happens before the part that blocks."
        warn ""
        warn "Wait a couple of minutes, then check:  $0 status"
        warn "You are looking for egpu_enable=0 and the internal dGPU back on the bus."
        return "$wrc"
    fi
    (( wrc != 0 )) && return "$wrc"

    ok "egpu_enable now reads: $(read_attr "$ATTR_ENABLE")"
    [[ $(read_attr "$FW/pending_reboot") == 1 ]] &&
        info "pending_reboot is set (WMI result 0x02) — reboot to settle the change"
    reload_nvidia
    return 0
}

usage() {
    cat <<'EOF'
xgm-egpu — XG Mobile eGPU control for the ROG Flow X13 (GV301QH)

  xgm-egpu status              show attributes, bus, modules, blockers
  xgm-egpu detect              show the autodetected topology and how it was
                               derived — run this first on a new machine, and
                               paste it into an issue if anything looks wrong
  xgm-egpu preflight           is NVIDIA RTD3 disarmed in the LOADED driver?
                               run after every driver/initramfs change
  xgm-egpu gsp [status|off|on] disable or re-enable NVIDIA GSP firmware. STRONGEST
                               current lead: every death has GSP RPCs in flight,
                               and GSP-off swaps the whole display-init path onto
                               the legacy CPU-side RM. Proprietary driver only
                               (this machine qualifies). 'off' then reload-driver
                               or reboot, then 'on'.
  xgm-egpu pcie [status|gen3|default]
                               tell the RM that PCIe Gen3 is allowed
                               (NVreg_EnablePCIeGen3=1). Found 2026-09-09 21:05:
                               every death is the RM retraining the link down to
                               the generation it allows, ~10 s after init, and
                               this link does not survive a retrain at Gen3.
                               Either this (full Gen3 x8) or 'on --link-gen 2'
                               (Gen2 x8, no equalization, safest).
  xgm-egpu logs [N|show|dir]   the persistent per-run logs: every on/off/bind/
                               reload-driver writes its full output to
                               /var/log/xgm-egpu/<time>-<cmd>.log, and the watch
                               saves the kernel log beside it. Survives reboots.
  xgm-egpu drm [status|nofbdev|nokms|safe|default]
                               set what the LOADED nvidia_drm does to the eGPU when
                               it appears. It attaches by itself, with the parameters
                               it booted with — modprobe cannot change a resident
                               module, which is why every earlier --no-fbdev /
                               --no-kms / --modeset-safe run silently ran the default.
                                 nokms    modeset=0          render node only, and
                                                             'on --no-kms' seals
                                                             /dev/nvidia-modeset so
                                                             no client can bring the
                                                             display engine up.
                                                             PRIME offload works.
                                                             TRY THIS
                                 nofbdev  modeset=1 fbdev=0  died 2026-09-09 19:30,
                                                             identical. Ruled out
                                 safe     nofbdev + nvidia_modeset HDMI-FRL/VRR off
                               Writes /etc/modprobe.d/nvidia-xgm-drm.conf and rebuilds
                               the initramfs; reload-driver or reboot applies it.
  xgm-egpu capture [arm|read]  'on' and 'bind' ARM this automatically before the
                               risky step (--no-capture to skip): the next hard
                               hang becomes a panic with a backtrace in EFI pstore,
                               plus netconsole to the Pi, best-effort. READ after
                               a hang+reboot to see the kernel's last words.
  xgm-egpu reload-driver       unload+reload the NVIDIA stack so a new modprobe.d
                               value takes effect NOW, no reboot, no initramfs.
                               Refuses if anything holds the GPU. eGPU must be off.
  xgm-egpu on                  release the internal dGPU, then activate
  xgm-egpu bind <target>       bind ONE layer of the driver stack to an already
                               enumerated eGPU (after 'on --no-reload') and watch
                               whether the link dies, logging who opens the
                               display nodes. Established 2026-09-09:
                                 core         nvidia only            SURVIVES
                                 modeset      + nvidia_modeset only  ?  <- run this
                                 drm-nokms    + nvidia_drm modeset=0 ?
                                 drm-nofbdev  + nvidia_drm fbdev=0   ?
                                 drm          + nvidia_drm (full)    DIES ~10s
                                 audio        snd_hda_intel on HDMI  ?
                                 all          everything
  xgm-egpu watch [SECS] [FILE] sample power state every 0.5s after 'on' —
                               shows exactly what changes when a link dies
  xgm-egpu off                 deactivate and restore the internal dGPU
  xgm-egpu link [BDF]          PCIe link speed/width and error counters
  xgm-egpu link-speed <1-4>    pin the root port's target PCIe generation and
                               retrain — the link on this machine is stable at a
                               steady speed but fails when changing speed
  xgm-egpu ec                  decode the EC's XGM state block (connect/lock/AC)
  xgm-egpu install-rules       persist the runtime-PM pinning via udev +
                               modprobe.d, so the eGPU survives reboots

Options:
  --force-kill    kill processes holding /dev/nvidia* instead of refusing
  --no-capture    do not arm the hang capture (pstore, panic-on-hang, netconsole)
                  before activating. It is armed by default on every 'on'/'bind'.
  --audio         let snd_hda_intel bind the eGPU's HDMI-audio function (01:00.1).
                  OFF by default since 2026-09-09 21:30: every recorded death has
                  the HDA codec active at the instant of Link Down (ELD reads,
                  "GPU sound probed, but not operational") and the GSP RPC in
                  flight is always DFP_SET_ELD_AUDIO_CAPS; both survivors had no
                  driver on that function and the internal 1650 has none. 'on'
                  enumerates with autoprobe off, fences 01:00.1 with a
                  driver_override, binds nvidia to 01:00.0 by hand. 'bind audio'
                  binds it later on purpose.
  --no-seal       with --no-kms, do NOT bind-mount /dev/null over /dev/nvidia-modeset.
                  Sealed by default: kwin allocates the display engine 1.5 s after a
                  GPU appears and every PRIME client does at start (measured), and
                  that bring-up is what dies. Sealed, every NVKMS ioctl fails and
                  clients carry on (tested); 'off' unseals.
  --release LEVEL how much to tear down first (default: minimal)
                    minimal  stop nvidia-powerd/persistenced only; the driver
                             stays bound so the ACPI eject is a real one, which
                             is what the AML's SUMA/WAT1 loop polls for
                    unload   also unbind the driver and rmmod the stack
                    remove   also remove the device from the PCI tree
                  On this machine 'minimal' is the only level that has ever
                  survived; 'remove' fails fastest. See the RELEASE_LEVEL comment.
  --no-reload     stop after the eGPU enumerates, without binding the NVIDIA
                  driver — separates an enumeration fault from a driver fault.
                  Disables PCI driver autoprobe for the duration, otherwise the
                  resident module binds on its own and the flag is meaningless.
  --ignore-rtd3   activate even though the loaded driver has RTD3 armed. Only
                  for reproducing the 10-second link death on purpose.
  --survival N    after the bind, watch the link for N seconds and report whether
                  it survived (default 15; the old failure was at 10). 0 to skip.
  --no-kms        require the LOADED nvidia_drm to have modeset=0 ('drm nokms' +
                  reload-driver; 'on' refuses otherwise). A render node and nothing
                  else: no KMS, no fbdev, no display-engine bring-up. PRIME offload
                  keeps working through a system-memory path (ioctl-traced
                  2026-09-09). Applies to 'on'.
  --cap-power     after the core binds and before the display engine loads, lock
                  the GPU to its minimum clocks and lowest power limit. Tests the
                  leading hypothesis: the display-init current step trips the
                  board's over-current hiccup (osy Diary documents the GPU on two
                  parallel supplies with FET-cutting OCP). If the link then
                  survives, cap power at boot and it works. Applies to 'on'.
  --modeset-safe  load nvidia_modeset with disable_hdmi_frl=1
                  disable_vrr_memclk_switch=1 conceal_vrr_caps=1. The RPCs in
                  flight at every death are HDMI-audio (SET_ELD_AUDIO_CAPS,
                  SET_HDMI_AUDIO_MUTESTREAM, CTRL_HDMI) and VRR setup on the
                  3060's physical outputs — the 1650 Mobile has no outputs and
                  survives the same init. Requires 'drm safe' applied first;
                  'on' verifies the loaded values. 'on', 'bind drm'.
  --mask-pciehp   clear the root port's hotplug interrupt enables for the watch.
                  Every death has Xid 79 raised from irq/NN-pciehp: if the link
                  drop is momentary, this stops pciehp tearing the device down
                  and the eGPU survives it. Restored on exit. 'on' and 'bind'.
  --no-fbdev      require the LOADED nvidia_drm to have fbdev=0 ('drm nofbdev' +
                  reload-driver). Tested for real 2026-09-09 19:30 (fbdev=N
                  verified in the loaded module, no fb1 line): died at 8.5s,
                  identical signature. Ruled out. Kept for the record.
  --no-drm-poll   set drm_kms_helper.poll=0 before nvidia_drm loads. RULED OUT
                  2026-09-09 by source: nvidia-drm calls drm_kms_helper_poll_disable
                  itself right after init, and marks every non-VGA connector
                  POLL_HPD, so the 10s DRM poll never runs for it. Kept only so
                  the record shows it was tested in code, not on hardware.
  --link-gen N    pin the root port's target PCIe generation (1-4) before the
                  switch and again after enumeration. On this machine the link
                  cannot complete training above Gen1: '--link-gen 1' is the
                  working mitigation (~2 GB/s, but stable).
  --aspm-performance
                  disable ASPM so the link holds its top speed. Sounds right,
                  measured worse here: pinned at Gen3 it died in ~18s at idle,
                  where Gen1 ran 15 minutes. Off by default.
  --dry-run       do everything except the sysfs write
  --timeout N     seconds to wait on the write before declaring a wedge (default 180)
  --root-port BDF override the detected PCIe root port (e.g. 0000:00:01.1)
  --internal-dgpu BDF
                  override the detected internal dGPU

Topology is autodetected from sysfs; you should not normally need to tell this
script anything about your machine. Persist overrides in /etc/xgm-egpu.conf:

    ROOT_PORT=0000:00:01.1
    INTERNAL_DGPU=0000:01:00.0
    INTERNAL_DEVID=0x1f9d

Hosts with no internal dGPU (ROG Ally) are supported: there is nothing sharing
the XGM's lanes, so activation triggers no eject and the release path is a no-op.

A timeout is not a rollback. The kernel commits to the EC (armoury_set_devstate)
BEFORE it calls armoury_pci_rescan(), and it is the rescan that blocks — on a lock
the ACPI eject already holds. So a write that never returns has very likely taken
effect anyway, and egpu_enable lives in the EC across reboots and power cycles.
Never read a timeout as "nothing happened".

'on' refuses to write unless every handle on the internal GPU is released.
That refusal is the point: writing with a holder present wedges the machine.
EOF
}

# Library mode: `XGM_LIBRARY_MODE=1 source bin/xgm-egpu` loads the functions
# without dispatching, so tests/ can exercise them against fixtures.
[[ ${XGM_LIBRARY_MODE:-0} -eq 1 ]] && return 0 2>/dev/null

XGM_ARGV="$*"
CMD=${1:-status}; shift || true
# An option in the command slot is the #1 way to get the usage dump by mistake
# (`xgm-egpu --cap-power --force-kill` — no verb). Say what happened instead.
if [[ $CMD == --* ]]; then
    die "'$CMD' is an option, not a command. Options go AFTER the command:
     $0 on $CMD ${*:-}
     (commands: status detect preflight gsp drm pcie logs reload-driver on off bind watch link link-speed ec install-rules)"
fi
while [[ $# -gt 0 ]]; do
    case "$1" in
        --force-kill) FORCE_KILL=1 ;;
        --release)    RELEASE_LEVEL=$2; shift ;;
        --release=*)  RELEASE_LEVEL=${1#*=} ;;
        --no-reload)  RELOAD_NVIDIA=0 ;;
        --ignore-rtd3) IGNORE_RTD3=1 ;;
        --survival)   SURVIVAL_SECS=$2; shift ;;
        --no-drm-poll) NO_DRM_POLL=1 ;;
        --no-fbdev)   NO_FBDEV=1 ;;
        --no-kms)     NO_KMS=1 ;;
        --no-capture) AUTO_CAPTURE=0 ;;
        --no-seal)    SEAL_NVKMS=0 ;;
        --audio)      NO_AUDIO=0 ;;
        --no-audio)   NO_AUDIO=1 ;;
        --mask-pciehp) MASK_PCIEHP=1 ;;
        --modeset-safe) MODESET_SAFE=1 ;;
        --cap-power)  CAP_POWER=1 ;;
        --aspm-performance) ASPM_PERF=1 ;;
        --link-gen)   LINK_GEN=$2; shift ;;
        --link-gen=*) LINK_GEN=${1#*=} ;;
        --dry-run)    DRY_RUN=1 ;;
        --timeout)    TIMEOUT=$2; shift ;;
        --root-port)  ROOT_PORT=$2; shift ;;
        --root-port=*) ROOT_PORT=${1#*=} ;;
        --internal-dgpu)   INTERNAL_DGPU=$2; shift ;;
        --internal-dgpu=*) INTERNAL_DGPU=${1#*=} ;;
        -h|--help)    usage; exit 0 ;;
        *)            break ;;
    esac
    shift
done

# Work out the machine before dispatching. Anything set above by flag, by the
# environment, or by /etc/xgm-egpu.conf survives — detection only fills blanks.
case "$CMD" in
    -h|--help) ;;
    *) [[ -e $ATTR_ENABLE ]] && detect_topology ;;
esac

case "$CMD" in
    on|off|bind|reload-driver|link-speed|install-rules|gsp|drm|pcie|capture) run_log_start "$CMD" "$XGM_ARGV" ;;
esac

case "$CMD" in
    status)     cmd_status ;;
    detect)     cmd_detect ;;
    preflight)  cmd_preflight ;;
    gsp)        cmd_gsp "${1:-status}" ;;
    drm)        cmd_drm "${1:-status}" ;;
    pcie)       cmd_pcie "${1:-status}" ;;
    logs)       cmd_logs "${1:-list}" ;;
    capture)    cmd_capture "${1:-arm}" ;;
    bind)       cmd_bind "${1:-core}" ;;
    reload-driver) cmd_reload_driver ;;
    watch)      cmd_watch "${1:-40}" "${2:-/tmp/xgm-watch.log}" ;;
    on)         cmd_on ;;
    off)        cmd_off ;;
    link)       cmd_link "${1:-}" ;;
    link-speed) cmd_link_speed "${1:-}" ;;
    # Not `A && B || C`: if ec_dump's od fails, C would run too and print the
    # decode after the dump.
    ec)         if [[ ${1:-} == --dump ]]; then ec_dump; else cmd_ec; fi ;;
    install-rules) cmd_install_rules ;;
    -h|--help)  usage ;;
    *)          usage; exit 1 ;;
esac
